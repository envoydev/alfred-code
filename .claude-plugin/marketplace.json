    {
      "name": "claude-stack-browser-extension",
      "source": "./",
      "description": "RETIRED in 1.3.0 - run /alfred-code:update: it copies the skills and agents you picked into the project and removes this entry.",
      "version": "1.3.0",
      "author": {
        "name": "envoydev",
        "url": "https://github.com/envoydev"
      },
      "strict": false,
      "skills": [
        "./stack/skills/browser-extension"
      ],
      "agents": [
        "./stack/agents/browser-extension-implementer.md",
        "./stack/agents/browser-extension-solution-designer.md",
        "./stack/agents/browser-extension-verifier.md"
      ],
