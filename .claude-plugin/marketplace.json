    {
      "name": "alfred-code",
      "source": "./",
      "description": "The Claude Code stack, guided: init installs it from scratch into a project (or globally; setup is its alias for one release), update refreshes an existing install and prunes what upstream removed, configure adjusts the selection (add or drop), validate reconciles an install to the project - prunes what its framework does not use and adds what the detected stacks are missing - all drive a dependency-complete selection with a prerequisite check; status shows the install read-only, per-area tables.",
      "version": "1.3.0",
      "author": {
        "name": "envoydev",
        "url": "https://github.com/envoydev"
      },
      "strict": false,
      "category": "development",
      "tags": [
        "setup",
        "installer",
        "skills",
        "agents",
        "mcp",
        "bootstrap"
      ],
      "commands": [
        "./setup-plugin/commands/init.md",
        "./setup-plugin/commands/setup.md",
        "./setup-plugin/commands/update.md",
        "./setup-plugin/commands/configure.md",
        "./setup-plugin/commands/validate.md",
        "./setup-plugin/commands/status.md"
      ],
      "skills": [
        "./setup-plugin/skills/alfred-code",
        "./stack/skills/docs-as-code",
        "./stack/skills/markdown-style",
        "./stack/skills/project-agent-capabilities",
        "./stack/skills/project-architecture-analyzer",
        "./stack/skills/project-architecture-quality-analyzer",
        "./stack/skills/project-architecture-quality-loop",
        "./stack/skills/project-ci-failure-signatures",
        "./stack/skills/project-code-style-analyzer",
        "./stack/skills/project-commit-checkpoint",
        "./stack/skills/project-diagnose-failure",
        "./stack/skills/project-first-look",
        "./stack/skills/project-implementer",
        "./stack/skills/project-quality-loop",
        "./stack/skills/project-runtime-failure-signatures",
        "./stack/skills/project-solution-design",
        "./stack/skills/project-solve-cross-task",
        "./stack/skills/project-solve-task",
        "./stack/skills/project-test-coverage-analyzer",
        "./stack/skills/project-test-coverage-loop",
        "./stack/skills/project-verify-code",
        "./stack/skills/project-verify-plan",
        "./stack/skills/project-version-upgrade"
      ],
      "agents": [
        "./stack/agents/architecture-analyzer.md",
        "./stack/agents/ci-failure-diagnoser.md",
        "./stack/agents/code-style-analyzer.md",
        "./stack/agents/evidence-gatherer.md",
        "./stack/agents/integration-reviewer.md",
        "./stack/agents/runtime-failure-diagnoser.md",
        "./stack/agents/security-auditor.md",
        "./stack/agents/test-coverage-analyzer.md"
      ],
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "AskUserQuestion",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/setup-plugin/hooks/guard-layer-table.js\"",
                "timeout": 10
              }
            ]
          }
        ],
        "SessionStart": [
          {
            "matcher": "startup",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/setup-plugin/hooks/library-stamp.js\"",
                "timeout": 10
              }
            ]
          }
        ]
      }
    },
