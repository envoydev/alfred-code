{
  "name": "envoydev",
  "owner": {
    "name": "envoydev",
    "url": "https://github.com/envoydev"
  },
  "metadata": {
    "description": "Claude Code agent stack - skills, agents, rules, hooks, and MCP servers, installed and updated via the alfred-code plugin.",
    "version": "1.3.0"
  },
  "plugins": [
    {
      "name": "alfred-code-hooks",
      "source": "./",
      "description": "The seventeen alfred-code hooks, wired inline: the deterministic gates (force-push, catastrophic rm, whole-file reads, credential reads, ungated dispatch and commit, cross-project writes, weakened check configs, the stop contract, the answer budget, the fresh-session offer), a session monitor that never denies, plus the docs, memory and session-history hooks.",
      "version": "1.3.0",
      "author": {
        "name": "envoydev",
        "url": "https://github.com/envoydev"
      },
      "strict": false,
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "Bash|PowerShell",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-protected-force-push.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-catastrophic-rm.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-read-whole-file.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-secret-value.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-ungated-commit.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Read",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-read-whole-file.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-secret-value.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Grep",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-secret-value.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Task|Agent",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-unapproved-dispatch.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "AskUserQuestion",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-stop-contract.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Skill",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-fresh-session-start.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-config-protection.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-cross-project-write.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Grep|Glob",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/docs-session.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": ".*",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/instrument-tool-usage.js\"",
                "timeout": 10
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-stop-contract.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-answer-length.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/docs-session.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/check-turn-build.js\"",
                "timeout": 60
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/history-session.js\"",
                "timeout": 10
              }
            ]
          }
        ],
        "SubagentStop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-stop-contract.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/docs-session.js\"",
                "timeout": 10
              }
            ]
          }
        ],
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-fresh-session-start.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-answer-length.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/monitor-session.js\"",
                "timeout": 10
              }
            ]
          }
        ],
        "SessionStart": [
          {
            "matcher": "compact",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-fresh-session-start.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-answer-length.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/docs-session.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/memory-session.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/history-session.js\"",
                "timeout": 10
              }
            ]
          }
        ],
        "PreCompact": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-fresh-session-start.js\"",
                "timeout": 10
              }
            ]
          }
        ],
        "SubagentStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/docs-session.js\"",
                "timeout": 10
              }
            ]
          }
        ],
        "PostToolUse": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/monitor-session.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Write|Edit|MultiEdit",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/check-turn-build.js\"",
                "timeout": 60
              }
            ]
          }
        ]
      },
      "dependencies": [
        "alfred-code"
      ]
    },
    {
      "name": "serena",
      "source": "./",
      "description": "serena as a plugin: LSP symbol navigation for the house stack. Per-project SERENA_HOME (.serena/home) keeps its registry, memories, logs and LSP cache out of every other project; --project-from-cwd self-activates the repo, which works because a plugin server's cwd IS the project dir (measured). Dashboard off, pinned PyPI package rather than a git ref, started through a launcher that pins the Python its compiled dependencies have wheels for (3.13; the x64 build on Windows on ARM).",
      "version": "1.3.0",
      "author": {
        "name": "envoydev",
        "url": "https://github.com/envoydev"
      },
      "strict": false,
      "mcpServers": {
        "serena": {
          "command": "node",
          "env": {
            "SERENA_HOME": ".serena/home"
          },
          "args": [
            "${CLAUDE_PLUGIN_ROOT}/stack/mcp/serena-launch.js",
            "--package",
            "serena-agent@1.7.0",
            "--",
            "start-mcp-server",
            "--context",
            "claude-code",
            "--enable-web-dashboard",
            "false",
            "--project-from-cwd"
          ]
        }
      }
    },
    {
      "name": "context7",
      "source": "./",
      "description": "context7 as a plugin: up-to-date library, framework, SDK and CLI documentation, which beats recalled API knowledge. The hosted remote server - no local process, and no key in any file. This is the one the core depends on, so it can never be dropped; `--context7 local` adds the context7-local entry beside it for the npx transport.",
      "version": "1.3.0",
      "author": {
        "name": "envoydev",
        "url": "https://github.com/envoydev"
      },
      "strict": false,
      "mcpServers": {
        "context7": {
          "type": "http",
          "url": "https://mcp.context7.com/mcp",
          "headers": {
            "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY:-}"
          }
        }
      }
    },
    {
      "name": "memory",
      "source": "./",
      "description": "memory as a plugin: the shared recall the stack reads at every session start - preferences, corrections, project facts and agent lessons, searchable by meaning. The database path is the install's level choice (global, scoped or project), so this one server starts through a launcher that reads the project's own settings.json - a plugin entry cannot expand a PROJECT env key (measured).",
      "version": "1.3.0",
      "author": {
        "name": "envoydev",
        "url": "https://github.com/envoydev"
      },
      "strict": false,
      "mcpServers": {
        "memory": {
          "command": "node",
          "args": [
            "${CLAUDE_PLUGIN_ROOT}/stack/mcp/memory-launch.js",
            "--package",
            "mcp-memory-service[sqlite]==11.13.0"
          ],
          "env": {
            "MCP_MEMORY_STORAGE_BACKEND": "sqlite_vec",
            "MCP_MEMORY_SQLITE_PRAGMAS": "busy_timeout=15000"
          }
        }
      }
    },
    {
      "name": "angular-cli",
      "source": "./",
      "description": "The Angular CLI MCP server as a plugin: workspace-aware Angular tooling. Unpinned on purpose - it matches the ng the workspace itself resolves.",
      "version": "1.3.0",
      "author": {
        "name": "envoydev",
        "url": "https://github.com/envoydev"
      },
      "strict": false,
      "mcpServers": {
        "angular-cli": {
          "command": "npx",
          "args": [
            "-y",
            "@angular/cli",
            "mcp"
          ]
        }
      },
      "dependencies": [
        "alfred-code"
      ]
    },
    {
      "name": "chrome-devtools",
      "source": "./",
      "description": "chrome-devtools as a plugin: browser and extension debugging through a full Chrome. Heavy, and it needs a real Chrome on the machine, so no stack seeds it - it is an opt-in pick.",
      "version": "1.3.0",
      "author": {
        "name": "envoydev",
        "url": "https://github.com/envoydev"
      },
      "strict": false,
      "mcpServers": {
        "chrome-devtools": {
          "command": "npx",
          "args": [
            "-y",
            "chrome-devtools-mcp@1.9.0"
          ]
        }
      },
      "dependencies": [
        "alfred-code"
      ]
    },
    {
      "name": "appium-mcp",
      "source": "./",
      "description": "The official Appium MCP server as a plugin: native mobile end-to-end driving with the embedded UiAutomator2 and XCUITest drivers. Needs Xcode and/or the Android SDK plus Java, so no stack seeds it - it arrives pre-selected on an appium or webdriverio dependency.",
      "version": "1.3.0",
      "author": {
        "name": "envoydev",
        "url": "https://github.com/envoydev"
      },
      "strict": false,
      "mcpServers": {
        "appium-mcp": {
          "command": "npx",
          "args": [
            "-y",
            "appium-mcp@1.94.3"
          ]
        }
      },
      "dependencies": [
        "alfred-code"
      ]
    },
    {
      "name": "sentry",
      "source": "./",
      "description": "Sentry's hosted remote MCP as a plugin: issues, events and releases from the project's own Sentry org. SENTRY_SLUG and SENTRY_ACCESS_TOKEN live in the ACCOUNT settings.json env; the auth header is built by a helper so the token never reaches a command line, and oauth mode simply sends no header.",
      "version": "1.3.0",
      "author": {
        "name": "envoydev",
        "url": "https://github.com/envoydev"
      },
      "strict": false,
      "mcpServers": {
        "sentry": {
          "type": "http",
          "url": "https://mcp.sentry.dev/mcp/${SENTRY_SLUG}",
          "headersHelper": "node \"${CLAUDE_PLUGIN_ROOT}/stack/mcp/sentry-headers.js\" \"${CLAUDE_PROJECT_DIR}\""
        }
      },
      "dependencies": [
        "alfred-code"
      ]
    },
    {
      "name": "context7-local",
      "source": "./",
      "description": "context7 over the local npx transport, as a plugin: the same up-to-date library and framework documentation as the hosted server, run as a local process instead - for a setup that bakes CONTEXT7_API_KEY into the registration rather than reading it from the account settings. Added by `--context7 local`; disable the hosted `context7` server beside it, or both answer.",
      "version": "1.3.0",
      "author": {
        "name": "envoydev",
        "url": "https://github.com/envoydev"
      },
      "strict": false,
      "mcpServers": {
        "context7-local": {
          "command": "npx",
          "args": [
            "-y",
            "@upstash/context7-mcp@4.1.1"
          ]
        }
      },
      "dependencies": [
        "alfred-code"
      ]
    },
    {
      "name": "playwright-chrome",
      "source": "./",
      "description": "playwright (chrome) as a plugin: drive a real chrome browser for visual checks and web app verification. One plugin per engine, so a project pays only for the browsers it picked; the profile and the screenshot output dir live under the project's .playwright/chrome.",
      "version": "1.3.0",
      "author": {
        "name": "envoydev",
        "url": "https://github.com/envoydev"
      },
      "strict": false,
      "mcpServers": {
        "playwright-chrome": {
          "command": "npx",
          "args": [
            "-y",
            "@playwright/mcp@0.0.82",
            "--browser",
            "chrome",
            "--user-data-dir",
            "${CLAUDE_PROJECT_DIR}/.playwright/chrome",
            "--output-dir",
            "${CLAUDE_PROJECT_DIR}/.playwright/chrome/output"
          ]
        }
      },
      "dependencies": [
        "alfred-code"
      ]
    },
