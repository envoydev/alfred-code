{
  "name": "envoydev",
  "owner": {
    "name": "envoydev",
    "url": "https://github.com/envoydev"
  },
  "metadata": {
    "description": "Claude Code agent stack - skills, agents, rules and hooks, installed and updated via the alfred-code plugin.",
    "version": "3.6.0"
  },
  "plugins": [
    {
      "name": "preferred-tools",
      "source": {
        "source": "github",
        "repo": "envoydev/preferred-tools",
        "ref": "main",
        "sha": "33f60bf31df899e3f33d7a0d20c2646d35b1830c"
      },
      "description": "The MCP servers and Claude Code plugins its owner has tested and likes, with their install, update, rename and fix procedures: /preferred-tools:install, /preferred-tools:configure, /preferred-tools:update and /preferred-tools:fix.",
      "author": {
        "name": "envoydev",
        "url": "https://github.com/envoydev"
      },
      "category": "development"
    },
    {
      "name": "session-inspector",
      "source": {
        "source": "github",
        "repo": "envoydev/alfred-mods",
        "ref": "v0.2.0",
        "sha": "2c7142c79520bcaaf476f6ea5b4f3f118ceb7494"
      },
      "description": "Context, usage, cost, tool failures, agents, cache and plan progress in one calm band and an /inspect pane. Works on Claude Code alone; with Alfred Code installed it also shows the stack's mode, runway and handoff.",
      "author": {
        "name": "envoydev",
        "url": "https://github.com/envoydev"
      },
      "category": "productivity"
    },
    {
      "name": "alfred-code",
      "source": "./",
      "description": "The Claude Code stack, guided: init installs it from scratch into a project and, typed again after the restart, bootstraps it once (tools, status line, captures, AGENTS.md), update refreshes an existing install and prunes what upstream removed, configure adjusts the selection (add or drop), validate reconciles an install to the project - prunes what its framework does not use and adds what the detected stacks are missing - all drive a dependency-complete selection with a prerequisite check; status shows the install read-only, per-area tables; uninstall removes what the install ledger says the stack wrote, and nothing of the user's.",
      "version": "3.6.0",
      "author": {
        "name": "envoydev",
        "url": "https://github.com/envoydev"
      },
      "strict": false,
      "category": "development",
      "tags": [
        "setup",
        "installer",
        "skills",
        "agents",
        "mcp",
        "bootstrap"
      ],
      "userConfig": {
        "hook_profile": {
          "type": "string",
          "title": "Hook profile",
          "description": "Which Alfred Code hooks run - one of minimal, standard, strict: minimal keeps only the rm, secret, force-push and desktop exec guards; standard is the default set; strict adds the Stop build check. Any other value runs as standard. A project's ALFRED_CODE_HOOKS_OFF still switches a hook off.",
          "default": "standard"
        }
      },
      "commands": [
        "./setup-plugin/commands/init.md",
        "./setup-plugin/commands/update.md",
        "./setup-plugin/commands/configure.md",
        "./setup-plugin/commands/validate.md",
        "./setup-plugin/commands/status.md",
        "./setup-plugin/commands/uninstall.md"
      ],
      "skills": [
        "./setup-plugin/skills/alfred-code"
      ],
      "agents": [
        "./stack/agents/angular-test-resolver.md",
        "./stack/agents/architecture-analyzer.md",
        "./stack/agents/aspnet-implementer.md",
        "./stack/agents/aspnet-solution-designer.md",
        "./stack/agents/aspnet-verifier.md",
        "./stack/agents/browser-extension-implementer.md",
        "./stack/agents/browser-extension-solution-designer.md",
        "./stack/agents/browser-extension-verifier.md",
        "./stack/agents/code-quality-analyzer.md",
        "./stack/agents/code-style-analyzer.md",
        "./stack/agents/console-implementer.md",
        "./stack/agents/console-solution-designer.md",
        "./stack/agents/console-verifier.md",
        "./stack/agents/data-implementer.md",
        "./stack/agents/data-solution-designer.md",
        "./stack/agents/data-verifier.md",
        "./stack/agents/devops-implementer.md",
        "./stack/agents/devops-solution-designer.md",
        "./stack/agents/devops-verifier.md",
        "./stack/agents/dotnet-build-error-resolver.md",
        "./stack/agents/dotnet-test-failure-resolver.md",
        "./stack/agents/evidence-gatherer.md",
        "./stack/agents/integration-reviewer.md",
        "./stack/agents/ionic-angular-implementer.md",
        "./stack/agents/ionic-angular-solution-designer.md",
        "./stack/agents/ionic-angular-verifier.md",
        "./stack/agents/issue-diagnoser-ci.md",
        "./stack/agents/issue-diagnoser-runtime.md",
        "./stack/agents/ng-build-error-resolver.md",
        "./stack/agents/output-scorer.md",
        "./stack/agents/related-project-analyzer.md",
        "./stack/agents/security-auditor.md",
        "./stack/agents/test-coverage-analyzer.md",
        "./stack/agents/web-angular-implementer.md",
        "./stack/agents/web-angular-solution-designer.md",
        "./stack/agents/web-angular-verifier.md",
        "./stack/agents/windows-service-implementer.md",
        "./stack/agents/windows-service-solution-designer.md",
        "./stack/agents/windows-service-verifier.md",
        "./stack/agents/winforms-implementer.md",
        "./stack/agents/winforms-solution-designer.md",
        "./stack/agents/winforms-verifier.md",
        "./stack/agents/wpf-implementer.md",
        "./stack/agents/wpf-solution-designer.md",
        "./stack/agents/wpf-verifier.md"
      ],
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "AskUserQuestion",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/setup-plugin/hooks/guard-layer-table.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-stop-contract.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Bash",
            "hooks": [
              {
                "type": "command",
                "if": "Bash(node *)",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/setup-plugin/hooks/guard-layer-table.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Bash|PowerShell|Monitor",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/shell-guards.js\"",
                "timeout": 100,
                "onFailure": "block"
              }
            ]
          },
          {
            "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/file-guards.js\"",
                "timeout": 70,
                "onFailure": "block"
              }
            ]
          },
          {
            "matcher": "^mcp__.+__browser_file_upload$",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-secret-value.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "^mcp__.+__(read_file|read_text_file|read_multiple_files)$",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-secret-value.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Task|Agent|SendMessage",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-unapproved-dispatch.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "^mcp__.*",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-ungated-commit.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/preferences-session.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "SubagentHandback",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-stop-contract.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/docs-session.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Skill",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-fresh-session-start.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/preferences-session.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Agent|Task",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-fresh-session-start.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "^mcp__.+__(write_file|edit_file|move_file)$",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-config-protection.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "^mcp__.+__(write_file|edit_file|move_file|create_directory)$",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-cross-project-write.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "^mcp__.+__App$|^mcp__.+__Shell$|^mcp__.+__browser_run_code_unsafe$",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-desktop-exec.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "^mcp__.+__(rename_symbol|safe_delete_symbol)$",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/docs-session.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "LSP",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/preferences-session.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": ".*",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/instrument-tool-usage.js\"",
                "timeout": 10,
                "async": true
              }
            ]
          }
        ],
        "PostToolUse": [
          {
            "matcher": "AskUserQuestion",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/setup-plugin/hooks/guard-layer-table.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-answer.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "Bash|PowerShell|Monitor",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/forge-session.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "^mcp__.*",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/forge-session.js\"",
                "timeout": 10
              }
            ]
          }
        ],
        "SessionStart": [
          {
            "matcher": "startup|clear|resume|fork",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/setup-plugin/hooks/library-stamp.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-secret-value.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-fresh-session-start.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/docs-session.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/preferences-session.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/history-session.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/forge-session.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "compact",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-answer.js\"",
                "timeout": 10
              }
            ]
          }
        ],
        "SubagentStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-unapproved-dispatch.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/docs-session.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/preferences-session.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/forge-session.js\"",
                "timeout": 10
              }
            ]
          }
        ],
        "SubagentStop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-unapproved-dispatch.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-stop-contract.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/docs-session.js\"",
                "timeout": 10
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-stop-contract.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/docs-session.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/history-session.js\"",
                "timeout": 60
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/forge-session.js\"",
                "timeout": 10
              },
              {
                "type": "prompt",
                "prompt": "You judge one thing about a Claude Code turn that is about to end: does its final message report work done while it leaves a next action still owed and unasked? The Stop hook input is below; `last_assistant_message` is the closing message, `stop_hook_active` is true when a Stop hook already sent this turn back once, and `background_tasks` lists work still running.\n\n$ARGUMENTS\n\nIf `stop_hook_active` is true, answer {\"ok\": true} and judge nothing else: a turn is sent back at most once here.\n\nHold the close only when BOTH are true:\n1. It reports a step finished in this turn - a fix landed, a file written, tests or a build passed, a commit or push made.\n2. It leaves a next action owed and states it as a fact or an offer in prose instead of asking: a step the assistant could take now ('Next I will update the changelog', 'I can add the tests if you want'), or a decision only the user can make - continue or stop, which deliverable next, commit or publish ('Say the word and I will commit', 'Remaining: wire the route').\n\nRelease the close when any of these is true:\n- Nothing is owed: it names no open next action, or says in one line that nothing is pending.\n- Every open item is a wait on work already running - an entry in background_tasks, a CI run, a dispatched agent, a build - or the user's own run they said they would do.\n- It answers a question the user asked and lists only facts or states, with no step or offer of its own.\n- An open item sits on a line opening 'Deferred by you:', or the only open item is an uncommitted diff held for the user's review stated as status.\n- The pending words sit inside quotes, a code span or quoted command output ('15f00b6c (not pushed)'), or under a negation ('nothing is committed or pushed').\n- It ends on a question to the user: another check judges asks, not this one.\n\nAnswer with JSON only, nothing before or after it. To let the turn end: {\"ok\": true}. To hold it: {\"ok\": false, \"reason\": \"<one or two sentences naming the owed item, then: put the pending decision through ONE AskUserQuestion call with the options you have in mind, the recommended one marked - or, when the owed step is yours and needs no decision, do it now>\"}. Never set \"impossible\": an owed item can always be asked.",
                "timeout": 30
              }
            ]
          }
        ],
        "UserPromptExpansion": [
          {
            "matcher": "(^|[^A-Za-z0-9_-])((alfred-)?(loop-[a-z][a-z0-9-]*|capture-[a-z][a-z0-9-]*|task-[a-z][a-z0-9-]*|issue-[a-z][a-z0-9-]*|mode-[a-z][a-z0-9-]*|review-code|review-security)|security-review|init|update|configure|validate)$",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-fresh-session-start.js\"",
                "timeout": 10
              }
            ]
          },
          {
            "matcher": "^((alfred-)?(capture|loop|task|issue|mode)-[a-z][a-z0-9-]*|review-code|review-security|code-review|security-review)$",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/preferences-session.js\"",
                "timeout": 10
              }
            ]
          }
        ],
        "PostModelSwitch": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-fresh-session-start.js\"",
                "timeout": 10
              }
            ]
          }
        ],
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-fresh-session-start.js\"",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-answer.js\"",
                "timeout": 10
              }
            ]
          }
        ],
        "PreCompact": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/stack/hooks/guard-fresh-session-start.js\"",
                "timeout": 10
              }
            ]
          }
        ]
      }
    }
  ]
}
