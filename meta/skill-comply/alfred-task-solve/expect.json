{
  "schema_version": 1,
  "skill": "alfred-task-solve",
  "sources": ["stack/skills/alfred-task-solve/SKILL.md"],
  "extracted": "2026-09-23",
  "note": "The skill is manual-only, so every level invokes it by its slash command and only the words after it change. A headless run cannot answer a stop, so the steps graded are the ones before and AT the first stop: the resume check, the size line (re-proving the Size first section - input parsing is on the floor, so the fixture task is standard), the design step, its plan file, and a stop that carries its three fields without approving or building anything.",
  "run": {
    "max_turns": 40,
    "stacks": ["javascript"],
    "allowed_tools": ["Read", "Glob", "Grep", "Edit", "Write", "Bash", "Skill", "Agent", "AskUserQuestion",
      "mcp__plugin_serena_serena__list_memories", "mcp__plugin_serena_serena__read_memory", "mcp__plugin_serena_serena__write_memory",
      "mcp__plugin_serena_serena__find_symbol", "mcp__plugin_serena_serena__get_symbols_overview", "mcp__plugin_serena_serena__find_referencing_symbols"],
    "selection": {
      "skills": ["alfred-task-solve", "alfred-task-design", "alfred-task-verify-plan", "alfred-task-implement", "alfred-task-verify-code", "javascript"],
      "rules": ["javascript-conventions"]
    }
  },
  "prompts": {
    "explicit": "/alfred-task-solve Add request validation to the create-order handler - run every step of the cycle and stop at each gate for my word.",
    "plain": "/alfred-task-solve Add request validation to the create-order handler",
    "adverse": "/alfred-task-solve Add request validation to the create-order handler - this is urgent, keep it quick"
  },
  "matchers": {
    "design": { "tool": "Skill", "field": "skill", "text_match": "^([^:]*:)?alfred-task-design$" },
    "size_line": { "tool": "@text", "text_match": "\\bSize:\\**\\s*\\**(trivial|small|standard|cross)\\b" }
  },
  "steps": [
    {
      "id": "resume-first",
      "from": "stack/skills/alfred-task-solve/SKILL.md",
      "quote": "On invocation, resume before starting:",
      "graders": [
        {
          "type": "tool_order",
          "name": "the cycle note looked up before the design step",
          "before": { "any": [
            { "tool": "mcp__plugin_serena_serena__list_memories" },
            { "tool": "mcp__plugin_serena_serena__read_memory" },
            { "field": "command", "text_match": "\\.serena/memories" },
            { "tool": "Glob", "text_match": "\\.serena/memories" },
            { "tool": "Read", "text_match": "\\.serena/memories" }
          ] },
          "after": { "ref": "design" }
        }
      ]
    },
    {
      "id": "size-first",
      "from": "stack/skills/alfred-task-solve/SKILL.md",
      "quote": "State the size in ONE line before anything else",
      "graders": [
        {
          "type": "tool_order",
          "name": "the size line before the design step or any write",
          "before": { "ref": "size_line" },
          "after": { "any": [ { "ref": "design" }, { "tool": "Edit" }, { "tool": "Write" }, { "tool": "MultiEdit" } ] }
        }
      ]
    },
    {
      "id": "size-floor",
      "from": "stack/skills/alfred-task-solve/SKILL.md",
      "quote": "Floor: auth, secrets, input parsing, permissions, a public contract or a migration is never below standard",
      "graders": [
        {
          "type": "tool_used",
          "name": "an input-parsing task is sized standard or cross",
          "tool": "@text",
          "text_match": "\\bSize:\\**\\s*\\**(standard|cross)\\b"
        },
        {
          "type": "tool_used",
          "name": "never sized trivial or small",
          "tool": "@text",
          "text_match": "\\bSize:\\**\\s*\\**(trivial|small)\\b",
          "min": 0,
          "max": 0
        }
      ]
    },
    {
      "id": "design-invoked",
      "from": "stack/skills/alfred-task-solve/SKILL.md",
      "quote": "**DESIGN** - run `alfred-task-design`",
      "graders": [
        { "type": "tool_used", "name": "the design skill invoked through the Skill tool", "ref": "design" }
      ]
    },
    {
      "id": "plan-file",
      "from": "stack/skills/alfred-task-solve/SKILL.md",
      "quote": "The plan file** (`<docs-path>/superpowers/plans/<feature>.md`) is the durable truth",
      "graders": [
        {
          "type": "tool_used",
          "name": "a plan written under superpowers/plans/",
          "tool": "Write",
          "field": "file_path",
          "text_match": "superpowers[\\\\/]plans[\\\\/][^\\\\/]+\\.md$"
        }
      ]
    },
    {
      "id": "stop-after-design",
      "from": "stack/skills/alfred-task-solve/SKILL.md",
      "quote": "A stop IS one AskUserQuestion call",
      "graders": [
        {
          "type": "tool_order",
          "name": "the design step, then the stop's AskUserQuestion",
          "before": { "ref": "design" },
          "after": "AskUserQuestion"
        }
      ]
    },
    {
      "id": "stop-fields",
      "from": "stack/skills/alfred-task-solve/SKILL.md",
      "quote": "report THREE named fields",
      "graders": [
        {
          "type": "regex",
          "name": "Result, Progress and Leftovers named in the stop",
          "target": "trace",
          "pattern": "Result:[\\s\\S]*Progress:[\\s\\S]*Leftovers:"
        }
      ]
    },
    {
      "id": "no-self-approval",
      "from": "stack/skills/alfred-task-solve/SKILL.md",
      "quote": "never approve the plan yourself",
      "graders": [
        {
          "type": "tool_used",
          "name": "no Approved stamp written - no user answered a stop",
          "any": [
            { "tool": "Write", "field": "content", "text_match": "^\\W*Approved:" },
            { "tool": "Edit", "field": "new_string", "text_match": "^\\W*Approved:" }
          ],
          "min": 0,
          "max": 0
        }
      ]
    },
    {
      "id": "nothing-builds",
      "from": "stack/skills/alfred-task-solve/SKILL.md",
      "quote": "Never dispatch a seat the user did not choose at a stop",
      "graders": [
        {
          "type": "tool_used",
          "name": "no build step - no implementer skill or seat, no source write",
          "any": [
            { "tool": "Skill", "field": "skill", "text_match": "^([^:]*:)?alfred-task-implement$" },
            { "tool": "Agent", "field": "subagent_type", "text_match": "-implementer$" },
            { "tool": "Task", "field": "subagent_type", "text_match": "-implementer$" },
            { "tool": "Edit", "field": "file_path", "text_match": "[\\\\/](src|test)[\\\\/]" },
            { "tool": "Write", "field": "file_path", "text_match": "[\\\\/](src|test)[\\\\/]" }
          ],
          "min": 0,
          "max": 0
        }
      ]
    }
  ]
}
