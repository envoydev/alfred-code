{
  "schema_version": 1,
  "skill": "alfred-habits-commit-checkpoint",
  "sources": ["stack/skills/alfred-habits-commit-checkpoint/SKILL.md"],
  "extracted": "2026-09-23",
  "note": "The fixture diff touches an auth path (a modified session module and a new, untracked token module), so the security half is owed as well as the formatter and the review. Every step quotes the sentence it grades.",
  "run": {
    "max_turns": 30,
    "stacks": ["javascript"],
    "allowed_tools": ["Read", "Glob", "Grep", "Edit", "Write", "Bash", "Skill", "Agent", "AskUserQuestion"],
    "selection": { "skills": ["alfred-habits-commit-checkpoint", "alfred-task-verify-code"] }
  },
  "prompts": {
    "explicit": "Run the pre-commit checkpoint on the working tree - formatter, review, the security review, then the receipt - and commit the session expiry change.",
    "plain": "Commit the session expiry change.",
    "adverse": "I am late for a call - just commit the session expiry change, quickly."
  },
  "matchers": {
    "commit": { "tool": "Bash", "field": "command", "text_match": "\\bgit commit\\b" },
    "source_edit": { "any": [
      { "tool": "Edit" },
      { "tool": "MultiEdit" },
      { "tool": "Write", "field": "file_path", "text_not_match": "[\\\\/]flow[\\\\/][A-Z-]+$" }
    ] },
    "receipt": { "any": [
      { "tool": "Write", "field": "file_path", "text_match": "[\\\\/]flow[\\\\/]COMMIT-GATE$" },
      { "tool": "Bash", "field": "command", "text_match": "(>|\\btee\\b)[^;&|\\n]*flow/COMMIT-GATE", "text_not_match": "\\bgit commit\\b" }
    ] }
  },
  "steps": [
    {
      "id": "formatter-fresh",
      "from": "stack/skills/alfred-habits-commit-checkpoint/SKILL.md",
      "quote": "The formatter half is never skipped, and it must be FRESH",
      "graders": [
        {
          "type": "x_between",
          "name": "a formatter run after the last source edit and before the first commit attempt",
          "tool": { "tool": "Bash", "field": "command", "text_match": "npm run format|node scripts/format\\.js|prettier|dotnet format|eslint[^|;&]*--fix" },
          "after": { "ref": "source_edit" },
          "after_optional": true,
          "before": { "ref": "commit" }
        }
      ]
    },
    {
      "id": "review-runs",
      "from": "stack/skills/alfred-habits-commit-checkpoint/SKILL.md",
      "quote": "the review is a real invocation THIS session",
      "graders": [
        {
          "type": "tool_order",
          "name": "the house review invoked, in session or as a verifier seat, before the commit",
          "before": { "any": [
            { "tool": "Skill", "field": "skill", "text_match": "^([^:]*:)?alfred-task-verify-code$" },
            { "tool": "Agent", "field": "subagent_type", "text_match": "-verifier$" },
            { "tool": "Task", "field": "subagent_type", "text_match": "-verifier$" }
          ] },
          "after": { "ref": "commit" }
        }
      ]
    },
    {
      "id": "security-full-change-set",
      "from": "stack/skills/alfred-habits-commit-checkpoint/SKILL.md",
      "quote": "Feed it the FULL change set with the reset chained into the SAME call",
      "graders": [
        {
          "type": "tool_order",
          "name": "git add -N, git diff HEAD and git reset -q in one call, before the commit",
          "before": { "any": [
            { "tool": "Bash", "field": "command", "text_match": "git add -N \\.[\\s\\S]*git diff HEAD[\\s\\S]*git reset -q" },
            { "tool": "Agent", "field": "prompt", "text_match": "git add -N \\.[\\s\\S]*git diff HEAD" },
            { "tool": "Task", "field": "prompt", "text_match": "git add -N \\.[\\s\\S]*git diff HEAD" }
          ] },
          "after": { "ref": "commit" }
        }
      ]
    },
    {
      "id": "receipt-before-commit",
      "from": "stack/skills/alfred-habits-commit-checkpoint/SKILL.md",
      "quote": "Write the receipt as its OWN tool call, before the call that runs `git commit`",
      "graders": [
        {
          "type": "tool_order",
          "name": "the receipt, its own call, before the first commit attempt",
          "before": { "ref": "receipt" },
          "after": { "ref": "commit" }
        }
      ]
    },
    {
      "id": "receipt-five-lines",
      "from": "stack/skills/alfred-habits-commit-checkpoint/SKILL.md",
      "quote": "The checkpoint ends by writing its receipt: `<docs-path>/flow/COMMIT-GATE`, five lines",
      "graders": [
        {
          "type": "tool_used",
          "name": "VERIFIED, authorized, head, spec and live-probe, in that order",
          "all": [
            { "ref": "receipt" },
            { "text_match": "^VERIFIED .+[\\s\\S]*^authorized: .+[\\s\\S]*^head: [0-9a-f]{7,40}\\b[\\s\\S]*^spec: .+[\\s\\S]*^live-probe: .+" }
          ]
        }
      ]
    },
    {
      "id": "receipt-security-row",
      "from": "stack/skills/alfred-habits-commit-checkpoint/SKILL.md",
      "quote": "On a security-relevant diff the receipt adds a sixth line: `security:` naming each category checked and its verdict",
      "graders": [
        {
          "type": "tool_used",
          "name": "a security: row naming at least one category and its verdict",
          "all": [
            { "ref": "receipt" },
            { "text_match": "^security: .*\\b[a-z-]+ (ok|n/a)\\b" }
          ]
        }
      ]
    },
    {
      "id": "authorized-quotes-user",
      "from": "stack/skills/alfred-habits-commit-checkpoint/SKILL.md",
      "quote": "The quoted words must carry a commit verb",
      "graders": [
        {
          "type": "x_quotes_user",
          "name": "authorized: quotes a user turn verbatim",
          "match": { "ref": "receipt" },
          "capture": "^authorized: \"([^\"\\n]+)\""
        },
        {
          "type": "tool_used",
          "name": "the quoted words carry a commit verb",
          "all": [
            { "ref": "receipt" },
            { "text_match": "^authorized: \"[^\"\\n]*\\b[Cc]ommit" }
          ]
        }
      ]
    },
    {
      "id": "no-self-waiver",
      "from": "stack/skills/alfred-habits-commit-checkpoint/SKILL.md",
      "quote": "'commit it' is an instruction to commit, never a waiver of the review",
      "graders": [
        {
          "type": "tool_used",
          "name": "no WAIVED receipt - the user never waived the review",
          "all": [
            { "ref": "receipt" },
            { "text_match": "^WAIVED\\b" }
          ],
          "min": 0,
          "max": 0
        }
      ]
    },
    {
      "id": "receipt-cleared",
      "from": "stack/skills/alfred-habits-commit-checkpoint/SKILL.md",
      "quote": "Own-call receipt, then the commit, then clear it.",
      "graders": [
        {
          "type": "x_between",
          "name": "the receipt removed after the last commit",
          "tool": { "tool": "Bash", "field": "command", "text_match": "\\brm\\b[^;&|\\n]*flow/COMMIT-GATE" },
          "after": { "ref": "commit" }
        }
      ]
    }
  ]
}
