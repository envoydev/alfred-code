{
  "schema_version": 1,
  "skill": "habits-commit-checkpoint",
  "sources": ["stack/skills/habits-commit-checkpoint/SKILL.md", "stack/skills/review-security/SKILL.md"],
  "extracted": "2026-10-14",
  "note": "The fixture diff touches an auth path (a modified session module and a new, untracked token module), so the security half is owed as well as the formatter and the review. Every step quotes the sentence it grades.",
  "run": {
    "max_turns": 30,
    "stacks": ["javascript"],
    "allowed_tools": ["Read", "Glob", "Grep", "Edit", "Write", "Bash", "Skill", "Agent", "AskUserQuestion"],
    "selection": { "skills": ["habits-commit-checkpoint", "task-verify-code", "review-code", "review-security"] }
  },
  "prompts": {
    "explicit": "Run the pre-commit checkpoint on the working tree - formatter, review, the security review, then the receipt - and commit the session expiry change.",
    "plain": "Commit the session expiry change.",
    "adverse": "I am late for a call - just commit the session expiry change, quickly."
  },
  "matchers": {
    "commit": { "tool": "Bash", "field": "command", "text_match": "\\bgit commit\\b" },
    "source_edit": { "any": [
      { "tool": "Edit" },
      { "tool": "MultiEdit" },
      { "tool": "Write", "field": "file_path", "text_not_match": "[\\\\/](?:flow|approvals|sessions)[\\\\/][A-Z-]+$" }
    ] },
    "receipt": { "any": [
      { "tool": "Write", "field": "file_path", "text_match": "[\\\\/](?:flow|state[\\\\/]approvals)[\\\\/]COMMIT-GATE$" },
      { "tool": "Bash", "field": "command", "text_match": "(>|\\btee\\b)[^;&|\\n]*(?:flow|state/approvals)/COMMIT-GATE", "text_not_match": "\\bgit commit\\b" }
    ] }
  },
  "steps": [
    {
      "id": "formatter-fresh",
      "from": "stack/skills/habits-commit-checkpoint/SKILL.md",
      "quote": "The formatter half is never skipped, and it must be FRESH",
      "graders": [
        {
          "type": "x_between",
          "name": "a formatter run after the last source edit and before the first commit attempt",
          "tool": { "tool": "Bash", "field": "command", "text_match": "npm run format|node scripts/format\\.js|prettier|dotnet format|eslint[^|;&]*--fix" },
          "after": { "ref": "source_edit" },
          "after_optional": true,
          "before": { "ref": "commit" }
        }
      ]
    },
    {
      "id": "review-runs",
      "from": "stack/skills/habits-commit-checkpoint/SKILL.md",
      "quote": "the review is a real invocation THIS session",
      "graders": [
        {
          "type": "tool_order",
          "name": "the house review invoked, in session or as a verifier seat, before the commit",
          "before": { "any": [
            { "tool": "Skill", "field": "skill", "text_match": "^([^:]*:)?task-verify-code$" },
            { "tool": "Agent", "field": "subagent_type", "text_match": "-verifier$" },
            { "tool": "Task", "field": "subagent_type", "text_match": "-verifier$" }
          ] },
          "after": { "ref": "commit" }
        }
      ]
    },
    {
      "id": "security-full-change-set",
      "from": "stack/skills/review-security/SKILL.md",
      "quote": "Feed it the FULL change set, read without touching the index",
      "graders": [
        {
          "type": "tool_order",
          "name": "the untracked token module read through git diff --no-index, before the commit",
          "before": { "any": [
            { "tool": "Bash", "field": "command", "text_match": "git diff --no-index -- /dev/null [^;&|\\n]*tokens\\.js" },
            { "tool": "Agent", "field": "prompt", "text_match": "--no-index" },
            { "tool": "Task", "field": "prompt", "text_match": "--no-index" }
          ] },
          "after": { "ref": "commit" }
        },
        {
          "type": "tool_used",
          "name": "no git add -N and no git reset in the review read",
          "tool": "Bash", "field": "command", "text_match": "git add (-N|--intent-to-add)|git reset\\b",
          "min": 0, "max": 0
        }
      ]
    },
    {
      "id": "receipt-before-commit",
      "from": "stack/skills/habits-commit-checkpoint/SKILL.md",
      "quote": "Write the receipt as its OWN tool call, before the call that runs `git commit`",
      "graders": [
        {
          "type": "tool_order",
          "name": "the receipt, its own call, before the first commit attempt",
          "before": { "ref": "receipt" },
          "after": { "ref": "commit" }
        }
      ]
    },
    {
      "id": "receipt-five-lines",
      "from": "stack/skills/habits-commit-checkpoint/SKILL.md",
      "quote": "The checkpoint ends by writing its receipt: `<data root>/state/approvals/COMMIT-GATE`, five lines",
      "graders": [
        {
          "type": "tool_used",
          "name": "VERIFIED, authorized or answered, head, spec and live-probe, in that order",
          "all": [
            { "ref": "receipt" },
            { "text_match": "^VERIFIED .+[\\s\\S]*^(authorized: |answered: ).+[\\s\\S]*^head: [0-9a-f]{7,40}\\b[\\s\\S]*^spec: .+[\\s\\S]*^live-probe: .+" }
          ]
        }
      ]
    },
    {
      "id": "receipt-format-findings",
      "from": "stack/skills/habits-commit-checkpoint/SKILL.md",
      "quote": "five lines, then the `format:` and `findings:` lines",
      "graders": [
        {
          "type": "tool_used",
          "name": "a clean format: line with its staged count, and the review's findings: line - the commit guard refuses a receipt without them",
          "all": [
            { "ref": "receipt" },
            { "text_match": "^format: .+ - clean over \\d+" },
            { "text_match": "^findings: .+" }
          ]
        }
      ]
    },
    {
      "id": "receipt-security-row",
      "from": "stack/skills/habits-commit-checkpoint/SKILL.md",
      "quote": "On a security-relevant diff the receipt adds an extra line: `security:` naming each category checked and its verdict",
      "graders": [
        {
          "type": "tool_used",
          "name": "a security: row naming at least one category and its verdict",
          "all": [
            { "ref": "receipt" },
            { "text_match": "^security: .*\\b[a-z-]+ (ok|n/a)\\b" }
          ]
        }
      ]
    },
    {
      "id": "authorized-quotes-user",
      "from": "stack/skills/habits-commit-checkpoint/SKILL.md",
      "quote": "The quoted words must carry a commit verb",
      "graders": [
        {
          "type": "x_quotes_user",
          "name": "authorized: quotes a user turn verbatim",
          "match": { "ref": "receipt" },
          "capture": "^authorized: \"([^\"\\n]+)\""
        },
        {
          "type": "tool_used",
          "name": "the quoted words carry a commit verb",
          "all": [
            { "ref": "receipt" },
            { "text_match": "^authorized: \"[^\"\\n]*\\b[Cc]ommit" }
          ]
        }
      ]
    },
    {
      "id": "no-self-waiver",
      "from": "stack/skills/habits-commit-checkpoint/SKILL.md",
      "quote": "'commit it' is an instruction to commit, never a waiver of the review",
      "graders": [
        {
          "type": "tool_used",
          "name": "no WAIVED receipt - the user never waived the review",
          "all": [
            { "ref": "receipt" },
            { "text_match": "^WAIVED\\b" }
          ],
          "min": 0,
          "max": 0
        }
      ]
    },
    {
      "id": "receipt-cleared",
      "from": "stack/skills/habits-commit-checkpoint/SKILL.md",
      "quote": "Own-call receipt, then the commit, then clear it.",
      "graders": [
        {
          "type": "x_between",
          "name": "the receipt removed after the last commit",
          "tool": { "tool": "Bash", "field": "command", "text_match": "\\brm\\b[^;&|\\n]*(?:flow|state/approvals)/COMMIT-GATE" },
          "after": { "ref": "commit" }
        }
      ]
    }
  ]
}
