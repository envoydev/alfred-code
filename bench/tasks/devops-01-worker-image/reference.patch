@@ -0,0 +1,22 @@
+# Build from the repository root: docker build -f src/LendingDesk.Worker/Dockerfile -t lendingdesk-worker .
+FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
+WORKDIR /src
+COPY global.json Directory.Build.props .editorconfig ./
+COPY src/LendingDesk.Domain/LendingDesk.Domain.csproj src/LendingDesk.Domain/
+COPY src/LendingDesk.Data/LendingDesk.Data.csproj src/LendingDesk.Data/
+COPY src/LendingDesk.Worker/LendingDesk.Worker.csproj src/LendingDesk.Worker/
+RUN dotnet restore src/LendingDesk.Worker/LendingDesk.Worker.csproj
+COPY src/LendingDesk.Domain/ src/LendingDesk.Domain/
+COPY src/LendingDesk.Data/ src/LendingDesk.Data/
+COPY src/LendingDesk.Worker/ src/LendingDesk.Worker/
+RUN dotnet publish src/LendingDesk.Worker/LendingDesk.Worker.csproj -c Release --no-restore -o /app
+
+# The worker serves no HTTP, so it runs on the plain runtime image and exposes no port.
+FROM mcr.microsoft.com/dotnet/runtime:10.0
+WORKDIR /app
+COPY --from=build /app .
+# The base image ships a non-root user it does not switch to by itself.
+USER $APP_UID
+# Supply the database as ConnectionStrings__Lending and the poll interval as Worker__PollSeconds.
+# The worker never runs migrations; apply them before pointing it at a database.
+ENTRYPOINT ["dotnet", "LendingDesk.Worker.dll"]
