+    [HttpDelete("{id:int}")]
+    [Authorize(Policy = Policies.Admin)]
+    public async Task<IActionResult> Erase(int id, CancellationToken cancellationToken)
+    {
+        var member = await Find(id, cancellationToken);
+        if (await db.Loans.AnyAsync(l => l.MemberId == id && l.ReturnedAt == null, cancellationToken))
+        {
+            throw new DomainException("member_has_open_loans", $"Member {id} still has a loan out and cannot be erased.");
+        }
+
+        member.Erase(clock.GetUtcNow());
+        await db.SaveChangesAsync(cancellationToken);
+        return NoContent();
+    }
+
     private async Task<Member> Find(int id, CancellationToken cancellationToken) =>
         await db.Members.FindAsync([id], cancellationToken) ?? throw new NotFoundException("Member", id);
 }
