diff --git a/src/LendingDesk.Data/Dockerfile b/src/LendingDesk.Data/Dockerfile
new file mode 100644
index 0000000..7def4e0
--- /dev/null
+++ b/src/LendingDesk.Data/Dockerfile
@@ -0,0 +1,19 @@
+# The migrations as one executable, run before the API and the worker start.
+# Build from the repository root: docker build -f src/LendingDesk.Data/Dockerfile -t lendingdesk-migrations .
+FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
+WORKDIR /src
+COPY global.json Directory.Build.props .editorconfig dotnet-tools.json ./
+RUN dotnet tool restore
+COPY src/LendingDesk.Domain/LendingDesk.Domain.csproj src/LendingDesk.Domain/
+COPY src/LendingDesk.Data/LendingDesk.Data.csproj src/LendingDesk.Data/
+RUN dotnet restore src/LendingDesk.Data/LendingDesk.Data.csproj
+COPY src/LendingDesk.Domain/ src/LendingDesk.Domain/
+COPY src/LendingDesk.Data/ src/LendingDesk.Data/
+RUN dotnet ef migrations bundle --project src/LendingDesk.Data --configuration Release --output /out/efbundle
+
+FROM mcr.microsoft.com/dotnet/runtime:10.0
+WORKDIR /app
+COPY --from=build /out/efbundle .
+USER $APP_UID
+# Pass the database as --connection '<connection string>'; applying an up-to-date schema changes nothing.
+ENTRYPOINT ["./efbundle"]
diff --git a/src/LendingDesk.Worker/Dockerfile b/src/LendingDesk.Worker/Dockerfile
new file mode 100644
index 0000000..4655ef6
--- /dev/null
+++ b/src/LendingDesk.Worker/Dockerfile
@@ -0,0 +1,22 @@
+# Build from the repository root: docker build -f src/LendingDesk.Worker/Dockerfile -t lendingdesk-worker .
+FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
+WORKDIR /src
+COPY global.json Directory.Build.props .editorconfig ./
+COPY src/LendingDesk.Domain/LendingDesk.Domain.csproj src/LendingDesk.Domain/
+COPY src/LendingDesk.Data/LendingDesk.Data.csproj src/LendingDesk.Data/
+COPY src/LendingDesk.Worker/LendingDesk.Worker.csproj src/LendingDesk.Worker/
+RUN dotnet restore src/LendingDesk.Worker/LendingDesk.Worker.csproj
+COPY src/LendingDesk.Domain/ src/LendingDesk.Domain/
+COPY src/LendingDesk.Data/ src/LendingDesk.Data/
+COPY src/LendingDesk.Worker/ src/LendingDesk.Worker/
+RUN dotnet publish src/LendingDesk.Worker/LendingDesk.Worker.csproj -c Release --no-restore -o /app
+
+# The worker serves no HTTP, so it runs on the plain runtime image and exposes no port.
+FROM mcr.microsoft.com/dotnet/runtime:10.0
+WORKDIR /app
+COPY --from=build /app .
+# The base image ships a non-root user it does not switch to by itself.
+USER $APP_UID
+# Supply the database as ConnectionStrings__Lending and the poll interval as Worker__PollSeconds.
+# The worker never runs migrations; apply them before pointing it at a database.
+ENTRYPOINT ["dotnet", "LendingDesk.Worker.dll"]
