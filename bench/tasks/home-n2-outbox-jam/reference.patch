+    [Fact]
+    public async Task A_message_for_a_deleted_loan_fails_on_its_own_and_is_set_aside_without_a_notice()
+    {
+        var deleted = await SeedLoanAsync(dueInDays: 7);
+        var kept = await SeedLoanAsync(dueInDays: 7);
+        await EnqueueAsync(EventTypes.LoanCreated, new LoanCreated(deleted.Id, deleted.MemberId, deleted.ItemId, deleted.StartDate, deleted.DueDate));
+        await EnqueueAsync(EventTypes.LoanCreated, new LoanCreated(kept.Id, kept.MemberId, kept.ItemId, kept.StartDate, kept.DueDate));
+        await EnqueueAsync(EventTypes.LoanReturned, new LoanReturned(kept.Id, kept.MemberId, _clock.Now));
+        await using (var db = NewDb())
+        {
+            await db.Loans.Where(l => l.Id == deleted.Id).ExecuteDeleteAsync();
+        }
+
+        await using (var db = NewDb())
+        {
+            Assert.Equal(2, await Processor(db).ProcessPendingAsync(CancellationToken.None));
+        }
+
+        Assert.Equal([NoticeKind.Confirmation, NoticeKind.ReturnReceipt], await NoticesForAsync(kept.Id));
+        await using (var db = NewDb())
+        {
+            var failed = await db.OutboxMessages.OrderBy(m => m.Id).FirstAsync();
+            Assert.Equal(1, failed.Attempts);
+            Assert.Null(failed.ProcessedAt);
+            Assert.Contains($"Loan {deleted.Id}", failed.LastError, StringComparison.Ordinal);
+        }
+
+        for (var attempt = 2; attempt <= OutboxProcessor.MaxAttempts; attempt++)
+        {
+            await using var db = NewDb();
+            Assert.Equal(0, await Processor(db).ProcessPendingAsync(CancellationToken.None));
+        }
+
+        await using var check = NewDb();
+        var setAside = await check.OutboxMessages.OrderBy(m => m.Id).FirstAsync();
+        Assert.Equal(OutboxProcessor.MaxAttempts, setAside.Attempts);
+        Assert.NotNull(setAside.ProcessedAt);
+        Assert.Empty(await NoticesForAsync(deleted.Id));
+    }
+
+    [Fact]
+    public async Task A_notice_the_database_refuses_is_counted_and_does_not_hold_up_the_next_message()
+    {
+        var refused = await SeedLoanAsync(dueInDays: 7);
+        var kept = await SeedLoanAsync(dueInDays: 7);
+        await EnqueueAsync(EventTypes.LoanCreated, new LoanCreated(refused.Id, refused.MemberId, refused.ItemId, refused.StartDate, refused.DueDate));
+        await EnqueueAsync(EventTypes.LoanCreated, new LoanCreated(kept.Id, kept.MemberId, kept.ItemId, kept.StartDate, kept.DueDate));
+        await using (var db = NewDb())
+        {
+            // The loan exists, but the notice insert still fails at the database, as it does when a
+            // loan is deleted between the check and the insert.
+            var refusedId = refused.Id.ToString(CultureInfo.InvariantCulture);
+            var sql = """
+                CREATE FUNCTION refuse_notice() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'notice refused'; END $$;
+                CREATE TRIGGER refuse_notice BEFORE INSERT ON "Notices" FOR EACH ROW WHEN (NEW."LoanId" = LOAN_ID) EXECUTE FUNCTION refuse_notice();
+                """.Replace("LOAN_ID", refusedId, StringComparison.Ordinal);
+            await db.Database.ExecuteSqlRawAsync(sql);
+        }
+
+        await using (var db = NewDb())
+        {
+            Assert.Equal(1, await Processor(db).ProcessPendingAsync(CancellationToken.None));
+        }
+
+        Assert.Equal([NoticeKind.Confirmation], await NoticesForAsync(kept.Id));
+        Assert.Empty(await NoticesForAsync(refused.Id));
