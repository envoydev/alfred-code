+    /// <summary>How many copies are free on each day from <c>from</c> through <c>to</c>, both included.</summary>
+    [HttpGet("{id:int}/availability")]
+    public async Task<IReadOnlyList<DayAvailabilityDto>> Availability(int id, [FromQuery] AvailabilityQuery query, CancellationToken cancellationToken)
+    {
+        var item = await Find(id, cancellationToken);
+        if (item.IsRetired)
+        {
+            throw new DomainException("item_retired", $"Item {item.Id} is retired and has no availability.");
+        }
+
+        var from = query.From!.Value;
+        var to = query.To!.Value;
+        var loans = await db.Loans
+            .AsNoTracking()
+            .Where(l => l.ItemId == item.Id && l.ReturnedAt == null && l.StartDate <= to && from <= l.DueDate)
+            .Select(l => new { l.StartDate, l.DueDate })
+            .ToListAsync(cancellationToken);
+
+        return Enumerable.Range(0, to.DayNumber - from.DayNumber + 1)
+            .Select(offset => from.AddDays(offset))
+            .Select(day => new DayAvailabilityDto(
+                day,
+                Math.Max(0, item.TotalStock - loans.Count(l => l.StartDate <= day && day <= l.DueDate))))
+            .ToList();
+    }
