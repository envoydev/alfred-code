+namespace LendingDesk.Worker.Notices;
+
+public sealed class NoticeOptions
+{
+    public const string Section = "Notices";
+
+    /// <summary>
+    /// How many days ahead a due-soon notice goes out: a loan gets it once its due date is between tomorrow and
+    /// this many days from today. 1 means the day before.
+    /// </summary>
+    public int DueSoonDays { get; set; } = 1;
+}
