diff --git a/web/src/app/reports/overdue-report/overdue-report.spec.ts b/web/src/app/reports/overdue-report/overdue-report.spec.ts
new file mode 100644
index 0000000..1087ea0
--- /dev/null
+++ b/web/src/app/reports/overdue-report/overdue-report.spec.ts
@@ -0,0 +1,71 @@
+import { HttpTestingController } from '@angular/common/http/testing';
+import { TestBed } from '@angular/core/testing';
+import { provideRouter } from '@angular/router';
+
+import { anOverdueLoan, provideApiTesting } from '../../testing/fixtures';
+import { OverdueReport } from './overdue-report';
+
+describe('OverdueReport', () => {
+  function setup() {
+    TestBed.configureTestingModule({ providers: [provideRouter([]), ...provideApiTesting()] });
+    const httpTesting = TestBed.inject(HttpTestingController);
+    const fixture = TestBed.createComponent(OverdueReport);
+    fixture.detectChanges();
+    return { httpTesting, fixture, element: fixture.nativeElement as HTMLElement };
+  }
+
+  it('shows each item with its SKU and links to the member and their email', async () => {
+    const { httpTesting, fixture, element } = setup();
+
+    httpTesting.expectOne('/api/reports/overdue').flush([
+      anOverdueLoan(),
+      anOverdueLoan({
+        loanId: 5,
+        item: { id: 3, name: 'Ladder', sku: 'LD-002' },
+        member: { id: 8, name: 'Grace Hopper', email: 'grace@example.com' },
+        dueDate: '2026-09-02',
+        daysOverdue: 2,
+      }),
+    ]);
+    await fixture.whenStable();
+
+    const rows = element.querySelectorAll('tbody tr');
+    expect(rows).toHaveLength(2);
+    const cells = rows[0].querySelectorAll('td');
+    expect(cells[0].textContent?.trim()).toBe('Ladder (LD-001)');
+    const [memberLink, mailLink] = Array.from(cells[1].querySelectorAll('a'));
+    expect(memberLink.getAttribute('href')).toBe('/members/7');
+    expect(memberLink.textContent?.trim()).toBe('Ada Lovelace');
+    expect(mailLink.getAttribute('href')).toBe('mailto:ada@example.com');
+    expect(mailLink.textContent?.trim()).toBe('ada@example.com');
+    expect(cells[2].textContent?.trim()).toBe('2026-09-01');
+    expect(cells[3].textContent?.trim()).toBe('3');
+    expect(rows[1].querySelector('td')?.textContent?.trim()).toBe('Ladder (LD-002)');
+    expect(rows[1].querySelector('a')?.getAttribute('href')).toBe('/members/8');
+    httpTesting.verify();
+  });
+
+  it('says so when nothing is overdue', async () => {
+    const { httpTesting, fixture, element } = setup();
+    expect(element.querySelector('tbody')?.textContent).toContain('Loading...');
+
+    httpTesting.expectOne('/api/reports/overdue').flush([]);
+    await fixture.whenStable();
+
+    expect(element.querySelector('tbody')?.textContent?.trim()).toBe('Nothing is overdue.');
+    httpTesting.verify();
+  });
+
+  it('shows the problem when the report cannot be loaded', async () => {
+    const { httpTesting, fixture, element } = setup();
+
+    httpTesting
+      .expectOne('/api/reports/overdue')
+      .flush({ title: 'Forbidden', status: 403 }, { status: 403, statusText: 'Forbidden' });
+    await fixture.whenStable();
+
+    expect(element.querySelector('[role="alert"]')?.textContent).toContain('Forbidden');
+    expect(element.querySelector('tbody')?.textContent?.trim()).toBe('Nothing is overdue.');
+    httpTesting.verify();
+  });
+});
