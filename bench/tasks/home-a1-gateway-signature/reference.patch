@@ -0,0 +1,128 @@
+using System.Net;
+using System.Security.Cryptography;
+using System.Text;
+using LendingDesk.IntegrationTests.Infrastructure;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+
+namespace LendingDesk.IntegrationTests;
+
+[Collection(DatabaseGroup.Name)]
+public sealed class GatewaySignatureTests(PostgresFixture postgres) : IAsyncLifetime
+{
+    private static readonly string GatewayKey = Convert.ToHexString(RandomNumberGenerator.GetBytes(32));
+
+    private LendingApiFactory _api = null!;
+    private WebApplicationFactory<Program> _gateway = null!;
+
+    public async Task InitializeAsync()
+    {
+        _api = await LendingApiFactory.StartAsync(postgres);
+        _gateway = WithGatewayKey(GatewayKey);
+    }
+
+    public async Task DisposeAsync()
+    {
+        await _gateway.DisposeAsync();
+        await _api.DisposeAsync();
+    }
+
+    private WebApplicationFactory<Program> WithGatewayKey(string key) =>
+        _api.WithWebHostBuilder(builder => builder.UseSetting("Auth:GatewayKey", key));
+
+    private static string Sign(string user, string role, string key) =>
+        Convert.ToHexStringLower(HMACSHA256.HashData(Encoding.UTF8.GetBytes(key), Encoding.UTF8.GetBytes($"{user}\n{role}")));
+
+    private static HttpClient Client(WebApplicationFactory<Program> factory, string role, string? signature, string user = "tester")
+    {
+        var client = factory.CreateClient();
+        client.DefaultRequestHeaders.Add("X-Demo-User", user);
+        client.DefaultRequestHeaders.Add("X-Demo-Role", role);
+        if (signature is not null)
+        {
+            client.DefaultRequestHeaders.Add("X-Demo-Signature", signature);
+        }
+
+        return client;
+    }
+
+    private static Task<HttpResponseMessage> CreateMemberAsync(HttpClient client) =>
+        client.PostJsonAsync("/api/members", new { name = "Gateway Member", email = $"{Guid.NewGuid():N}@example.com" });
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task A_correctly_signed_request_goes_through_in_either_hex_case(bool upperCase)
+    {
+        var signature = Sign("Ada Lovelace", "staff", GatewayKey);
+        var client = Client(_gateway, "staff", upperCase ? signature.ToUpperInvariant() : signature, user: "Ada Lovelace");
+
+        Assert.Equal(HttpStatusCode.Created, (await CreateMemberAsync(client)).StatusCode);
+        Assert.Equal(HttpStatusCode.OK, (await client.GetAsync("/api/members")).StatusCode);
+    }
+
+    [Fact]
+    public async Task A_signed_member_is_still_refused_staff_work()
+    {
+        var response = await CreateMemberAsync(Client(_gateway, "member", Sign("tester", "member", GatewayKey)));
+
+        Assert.Equal(HttpStatusCode.Forbidden, response.StatusCode);
+        Assert.Equal("forbidden", (await response.ReadAsync<Problem>()).Code);
+    }
+
+    [Theory]
+    [InlineData("missing")]
+    [InlineData("empty")]
+    [InlineData("other key")]
+    [InlineData("other role")]
+    [InlineData("other user")]
+    [InlineData("no line feed")]
+    [InlineData("truncated")]
+    [InlineData("not hex")]
+    public async Task A_request_without_a_valid_signature_is_not_signed_in(string signatureCase)
+    {
+        var signature = signatureCase switch
+        {
+            "missing" => null,
+            "empty" => string.Empty,
+            "other key" => Sign("tester", "member", Convert.ToHexString(RandomNumberGenerator.GetBytes(32))),
+            "other role" => Sign("tester", "admin", GatewayKey),
+            "other user" => Sign("someone else", "member", GatewayKey),
+            "no line feed" => Convert.ToHexStringLower(HMACSHA256.HashData(Encoding.UTF8.GetBytes(GatewayKey), Encoding.UTF8.GetBytes("testermember"))),
+            "truncated" => Sign("tester", "member", GatewayKey)[..62],
+            "not hex" => new string('z', 64),
+            _ => throw new ArgumentOutOfRangeException(nameof(signatureCase)),
+        };
+        var anonymous = await _gateway.CreateClient().PostJsonAsync("/api/members", new { name = "Nobody", email = "nobody@example.com" });
+
+        var response = await CreateMemberAsync(Client(_gateway, "member", signature));
+
+        Assert.Equal(HttpStatusCode.Unauthorized, anonymous.StatusCode);
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+        var expected = await anonymous.ReadAsync<Problem>();
+        var actual = await response.ReadAsync<Problem>();
+        Assert.Equal("unauthenticated", actual.Code);
+        Assert.Equal((expected.Status, expected.Title, expected.Detail, expected.Code), (actual.Status, actual.Title, actual.Detail, actual.Code));
+    }
+
+    [Fact]
+    public async Task A_signed_unknown_role_is_still_refused()
+    {
+        var response = await Client(_gateway, "owner", Sign("tester", "owner", GatewayKey)).GetAsync("/api/members");
+
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+        Assert.Equal("unauthenticated", (await response.ReadAsync<Problem>()).Code);
+    }
+
+    [Fact]
+    public async Task Without_a_gateway_key_the_headers_are_trusted_and_a_signature_is_ignored()
+    {
+        await using var emptyKey = WithGatewayKey(string.Empty);
+
+        var noKey = await CreateMemberAsync(Client(_api, "staff", signature: "not-a-signature"));
+        var blankKey = await CreateMemberAsync(Client(emptyKey, "staff", signature: null));
+
+        Assert.Equal(HttpStatusCode.Created, noKey.StatusCode);
+        Assert.Equal(HttpStatusCode.Created, blankKey.StatusCode);
+    }
+}
