+using Microsoft.AspNetCore.Authentication;
+
+namespace LendingDesk.Api.Auth;
+
+internal sealed class DemoHeaderAuthenticationOptions : AuthenticationSchemeOptions
+{
+    public const string GatewayKeySetting = "Auth:GatewayKey";
+
+    /// <summary>
+    /// The key the gateway signs the identity headers with. When set, unsigned or badly signed identity
+    /// headers are ignored; when absent or empty, the headers are trusted as they are.
+    /// </summary>
+    public string? GatewayKey { get; set; }
+}
diff --git a/src/LendingDesk.Api/Auth/GatewaySignature.cs b/src/LendingDesk.Api/Auth/GatewaySignature.cs
new file mode 100644
index 0000000..980dede
--- /dev/null
+++ b/src/LendingDesk.Api/Auth/GatewaySignature.cs
@@ -0,0 +1,23 @@
+using System.Buffers;
+using System.Security.Cryptography;
+using System.Text;
+
+namespace LendingDesk.Api.Auth;
+
+/// <summary>The gateway's signature over the identity headers: hex HMAC-SHA256 of <c>user + "\n" + role</c>.</summary>
+internal static class GatewaySignature
+{
+    public static bool Matches(string key, string user, string role, string signature)
+    {
+        Span<byte> provided = stackalloc byte[HMACSHA256.HashSizeInBytes];
+        if (signature.Length != provided.Length * 2
+            || Convert.FromHexString(signature, provided, out _, out _) != OperationStatus.Done)
+        {
+            return false;
+        }
+
+        Span<byte> expected = stackalloc byte[HMACSHA256.HashSizeInBytes];
+        HMACSHA256.HashData(Encoding.UTF8.GetBytes(key), Encoding.UTF8.GetBytes($"{user}\n{role}"), expected);
+        return CryptographicOperations.FixedTimeEquals(expected, provided);
+    }
+}
