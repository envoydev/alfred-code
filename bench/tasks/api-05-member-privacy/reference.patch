+using System.Security.Claims;
+using LendingDesk.Data;
+using Microsoft.EntityFrameworkCore;
+
+namespace LendingDesk.Api.Auth;
+
+/// <summary>
+/// Which member records and loans a caller may see: staff and admins see everything, a member-role caller only
+/// their own. Anything else is answered as if it did not exist, so a member cannot learn which ids are in use.
+/// </summary>
+internal sealed record Visibility(bool Everything, int? MemberId)
+{
+    public bool Allows(int memberId) => Everything || MemberId == memberId;
+}
+
+internal static class VisibilityExtensions
+{
+    /// <summary>A member-role caller is the member whose email matches their user name, ignoring case - the API stores emails lower-cased.</summary>
+    public static async Task<Visibility> VisibilityAsync(this LendingDbContext db, ClaimsPrincipal user, CancellationToken cancellationToken)
+    {
+        if (!user.IsInRole(Roles.Member))
+        {
+            return new Visibility(true, null);
+        }
+
+        var email = (user.Identity?.Name ?? string.Empty).Trim().ToLowerInvariant();
+        var memberId = await db.Members
+            .Where(m => m.Email == email)
+            .Select(m => (int?)m.Id)
+            .FirstOrDefaultAsync(cancellationToken);
+        return new Visibility(false, memberId);
+    }
+}
