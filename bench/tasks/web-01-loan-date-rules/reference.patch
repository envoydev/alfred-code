+/** The longest loan the API accepts, in days (LendingPolicy.MaxLoanDays on the server). */
+const MAX_LOAN_DAYS = 28;
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+type LoanDateRule = 'dueBeforeStart' | 'loanTooLong';
+
+/** The rule a pair of `yyyy-mm-dd` dates breaks, or null when they pass or one is missing. */
+function brokenLoanDateRule(startDate: string, dueDate: string): LoanDateRule | null {
+  // Date-only ISO strings parse as UTC midnight, so the difference is a whole number of days.
+  const start = Date.parse(startDate);
+  const due = Date.parse(dueDate);
+  if (Number.isNaN(start) || Number.isNaN(due)) {
+    return null;
+  }
+  const days = Math.round((due - start) / DAY_MS);
+  if (days < 0) {
+    return 'dueBeforeStart';
+  }
+  return days > MAX_LOAN_DAYS ? 'loanTooLong' : null;
+}
+
+function loanDates(group: AbstractControl): ValidationErrors | null {
+  const rule = brokenLoanDateRule(
+    group.get('startDate')?.value ?? '',
+    group.get('dueDate')?.value ?? '',
+  );
+  return rule ? { [rule]: true } : null;
+}
