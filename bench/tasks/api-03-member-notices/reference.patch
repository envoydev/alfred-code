+using LendingDesk.Api.Auth;
+using LendingDesk.Api.Contracts;
+using LendingDesk.Api.Errors;
+using LendingDesk.Data;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.EntityFrameworkCore;
+
+namespace LendingDesk.Api.Controllers;
+
+[ApiController]
+[Authorize(Policy = Policies.Staff)]
+public sealed class NoticesController(LendingDbContext db) : ControllerBase
+{
+    /// <summary>Every notice sent about the member's loans, returned loans included, newest first.</summary>
+    [HttpGet("/api/members/{memberId:int}/notices")]
+    public async Task<PagedResult<NoticeDto>> ForMember(int memberId, [FromQuery] NoticeQuery query, CancellationToken cancellationToken)
+    {
+        if (!await db.Members.AnyAsync(m => m.Id == memberId, cancellationToken))
+        {
+            throw new NotFoundException("Member", memberId);
+        }
+
+        var notices = db.Notices.AsNoTracking().Where(n => n.Loan.MemberId == memberId);
+        if (query.Kind is { } kind)
+        {
+            notices = notices.Where(n => n.Kind == kind);
+        }
+
+        // The id breaks ties between notices sent at the same instant, so pages never skip or repeat one.
+        return await notices
+            .OrderByDescending(n => n.SentAt)
+            .ThenByDescending(n => n.Id)
+            .Select(n => new NoticeDto(n.Id, n.LoanId, n.Loan.Item.Name, n.Kind, n.SentAt))
+            .ToPageAsync(query.Page, query.PageSize, cancellationToken);
+    }
+}
diff --git a/tests/LendingDesk.IntegrationTests/NoticesApiTests.cs b/tests/LendingDesk.IntegrationTests/NoticesApiTests.cs
