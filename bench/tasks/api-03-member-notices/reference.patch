+using System.ComponentModel.DataAnnotations;
+using LendingDesk.Domain.Notices;
+
+namespace LendingDesk.Api.Contracts;
+
+public sealed record NoticeDto(long Id, int LoanId, string ItemName, NoticeKind Kind, DateTimeOffset SentAt);
+
+/// <summary>Paged like the other lists, with its own limits: 10 notices a page by default, 50 at most.</summary>
+public sealed class NoticeQuery
+{
+    [Range(1, int.MaxValue)]
+    public int Page { get; init; } = 1;
+
+    [Range(1, 50)]
+    public int PageSize { get; init; } = 10;
+
+    public NoticeKind? Kind { get; init; }
+}
diff --git a/src/LendingDesk.Api/Contracts/Paging.cs b/src/LendingDesk.Api/Contracts/Paging.cs
