@@ -27,4 +27,21 @@ public sealed class Member
 
         Status = MemberStatus.Suspended;
     }
+
+    /// <summary>Puts a suspended member back to active.</summary>
+    /// <param name="hasOverdueLoans">Whether the member still holds a loan that is not returned and past its due date.</param>
+    public void Reinstate(bool hasOverdueLoans)
+    {
+        if (Status != MemberStatus.Suspended)
+        {
+            throw new DomainException("member_not_suspended", $"Member {Id} is not suspended.");
+        }
+
+        if (hasOverdueLoans)
+        {
+            throw new DomainException("member_has_overdue_loans", $"Member {Id} still has overdue loans and cannot be reinstated.");
+        }
+
+        Status = MemberStatus.Active;
+    }
 }
