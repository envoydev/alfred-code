diff --git a/src/LendingDesk.Data/Locking/LockingExtensions.cs b/src/LendingDesk.Data/Locking/LockingExtensions.cs
new file mode 100644
index 0000000..4bae5c4
--- /dev/null
+++ b/src/LendingDesk.Data/Locking/LockingExtensions.cs
@@ -0,0 +1,20 @@
+using LendingDesk.Domain.Items;
+using Microsoft.EntityFrameworkCore;
+
+namespace LendingDesk.Data.Locking;
+
+public static class LockingExtensions
+{
+    /// <summary>
+    /// Loads an item and locks its row until the current transaction ends, so a request that counts the
+    /// item's free copies and then takes one runs to its end before the next request for that item starts
+    /// counting. Call it inside a transaction: without one the lock is released as soon as the query ends.
+    /// </summary>
+    public static Task<Item?> FindForUpdateAsync(this DbSet<Item> items, int id, CancellationToken cancellationToken)
+    {
+        ArgumentNullException.ThrowIfNull(items);
+        return items
+            .FromSql($"""SELECT * FROM "Items" WHERE "Id" = {id} FOR UPDATE""")
+            .SingleOrDefaultAsync(cancellationToken);
+    }
+}
