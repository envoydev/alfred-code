+    [Theory]
+    [InlineData(1)]
+    [InlineData(2)]
+    public async Task Simultaneous_requests_for_the_same_dates_get_only_the_free_copies(int stock)
+    {
+        var (memberId, itemId) = await SeedAsync(stock);
+
+        var responses = await Task.WhenAll(Enumerable.Range(0, 10).Select(_ => LendAsync(memberId, itemId)));
+
+        Assert.Equal(stock, responses.Count(r => r.StatusCode == HttpStatusCode.Created));
+        var refused = responses.Where(r => r.StatusCode != HttpStatusCode.Created).ToList();
+        Assert.Equal(10 - stock, refused.Count);
+        foreach (var response in refused)
+        {
+            Assert.Equal(HttpStatusCode.Conflict, response.StatusCode);
+            Assert.Equal("item_unavailable", (await response.ReadAsync<Problem>()).Code);
+        }
+
+        Assert.Equal(stock, await _api.WithDbAsync(db => db.Loans.CountAsync(l => l.ItemId == itemId)));
+        Assert.Equal(stock, await _api.WithDbAsync(db => db.OutboxMessages.CountAsync(o => o.Type == EventTypes.LoanCreated)));
+    }
+
+    [Fact]
+    public async Task Simultaneous_requests_that_do_not_compete_all_succeed()
+    {
+        var (memberId, itemId) = await SeedAsync(stock: 1);
+        var otherItems = new List<int>();
+        for (var i = 0; i < 5; i++)
+        {
+            otherItems.Add((await SeedAsync(stock: 1)).ItemId);
+        }
+
+        var sameItemOtherWeeks = Enumerable.Range(0, 3).Select(week => LendAsync(memberId, itemId, startInDays: week * 7, days: 6));
+        var otherItemsSameDates = otherItems.Select(otherItem => LendAsync(memberId, otherItem));
+        var responses = await Task.WhenAll(sameItemOtherWeeks.Concat(otherItemsSameDates));
+
+        Assert.All(responses, r => Assert.Equal(HttpStatusCode.Created, r.StatusCode));
+    }
+
+    [Fact]
+    public async Task Lending_an_unknown_item_or_to_an_unknown_member_is_not_found_and_saves_nothing()
+    {
+        var (memberId, itemId) = await SeedAsync();
+
+        var unknownItem = await LendAsync(memberId, 999999);
+        var unknownMember = await LendAsync(999999, itemId);
+
+        Assert.Equal(HttpStatusCode.NotFound, unknownItem.StatusCode);
+        Assert.Equal("Item 999999 was not found.", (await unknownItem.ReadAsync<Problem>()).Detail);
+        Assert.Equal(HttpStatusCode.NotFound, unknownMember.StatusCode);
+        Assert.Equal("Member 999999 was not found.", (await unknownMember.ReadAsync<Problem>()).Detail);
+        Assert.Equal(0, await _api.WithDbAsync(db => db.Loans.CountAsync()));
+        Assert.Equal(HttpStatusCode.Created, (await LendAsync(memberId, itemId)).StatusCode);
+    }
+
