+    private static async Task AssertRefusedAsync(HttpResponseMessage response, string code)
+    {
+        Assert.Equal(HttpStatusCode.Conflict, response.StatusCode);
+        var problem = await response.ReadAsync<Problem>();
+        Assert.Equal(code, problem.Code);
+        Assert.Equal("Lending rule violated", problem.Title);
+        Assert.False(string.IsNullOrEmpty(problem.TraceId));
+    }
