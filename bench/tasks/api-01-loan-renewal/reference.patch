+    [HttpPost("{id:int}/renew")]
+    [Authorize(Policy = Policies.Staff)]
+    public async Task<LoanDto> Renew(int id, RenewalRequest request, CancellationToken cancellationToken)
+    {
+        var loan = await db.Loans
+            .Include(l => l.Item)
+            .Include(l => l.Member)
+            .SingleOrDefaultAsync(l => l.Id == id, cancellationToken)
+            ?? throw new NotFoundException("Loan", id);
+        var due = request.DueDate!.Value;
+
+        // The loan already holds its copy up to the current due date, so only the added days need a free one.
+        var addedFrom = loan.DueDate.AddDays(1);
+        var copiesOut = await db.Loans.CountAsync(
+            l => l.ItemId == loan.ItemId && l.Id != loan.Id && l.ReturnedAt == null && l.StartDate <= due && addedFrom <= l.DueDate,
+            cancellationToken);
+        LendingPolicy.EnsureCanRenew(loan, loan.Member, loan.Item, due, clock.Today(), copiesOut);
+
+        loan.DueDate = due;
+        await db.SaveChangesAsync(cancellationToken);
+        return await Get(id, cancellationToken);
+    }
+
