+    /// <summary>Throws when moving <paramref name="loan"/>'s due date to <paramref name="newDueDate"/> breaks a renewal rule.</summary>
+    /// <remarks>
+    /// The rules are checked in a fixed order and the first broken one is reported. The item's condition and
+    /// retirement do not matter: the borrower already has the copy.
+    /// </remarks>
+    /// <param name="copiesOut">
+    /// How many of the item's other open loans overlap the added days, from the day after the current due date
+    /// through <paramref name="newDueDate"/>.
+    /// </param>
+    public static void EnsureCanRenew(Loan loan, Member member, Item item, DateOnly newDueDate, DateOnly today, int copiesOut)
+    {
+        ArgumentNullException.ThrowIfNull(loan);
+        ArgumentNullException.ThrowIfNull(member);
+        ArgumentNullException.ThrowIfNull(item);
+        if (loan.ReturnedAt is not null)
+        {
+            throw new DomainException("loan_already_returned", $"Loan {loan.Id} was already returned.");
+        }
+
+        if (loan.DueDate < today)
+        {
+            throw new DomainException("loan_overdue", $"Loan {loan.Id} is overdue and has to be returned, not renewed.");
+        }
+
+        if (member.Status == MemberStatus.Suspended)
+        {
+            throw new DomainException("member_suspended", $"Member {member.Id} is suspended and cannot renew.");
+        }
+
+        if (newDueDate <= loan.DueDate)
+        {
+            throw new DomainException("renewal_not_later", "The new due date is not later than the current due date.");
+        }
+
+        if (newDueDate.DayNumber - loan.StartDate.DayNumber > MaxLoanDays)
+        {
+            throw new DomainException("loan_too_long", $"A loan can last at most {MaxLoanDays} days.");
+        }
+
+        if (copiesOut >= item.TotalStock)
+        {
+            throw new DomainException("item_unavailable", $"No copy of item {item.Id} is free for the added days.");
+        }
+    }
+
     public static bool Overlaps(DateOnly startA, DateOnly endA, DateOnly startB, DateOnly endB) =>
         startA <= endB && startB <= endA;
 }
