--- a/src/LendingDesk.Domain/Loans/LendingPolicy.cs
+++ b/src/LendingDesk.Domain/Loans/LendingPolicy.cs
@@ -7,6 +7,12 @@ public static class LendingPolicy
 {
     public const int MaxLoanDays = 28;
 
+    /// <summary>How many days past its due date a loan may run before it counts as overdue (decision 0001).</summary>
+    public const int OverdueGraceDays = 2;
+
+    /// <summary>A loan that is not returned is overdue on <paramref name="today"/> when its due date is before this day.</summary>
+    public static DateOnly OverdueBefore(DateOnly today) => today.AddDays(-OverdueGraceDays);
+
     /// <summary>Throws when lending <paramref name="item"/> to <paramref name="member"/> breaks a lending rule.</summary>
     /// <param name="copiesOut">How many copies of the item are already lent out over the requested period.</param>
     public static void EnsureCanLend(Member member, Item item, DateOnly startDate, DateOnly dueDate, DateOnly today, int copiesOut)
