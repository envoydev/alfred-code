+    /// <summary>The loans that are overdue today, by the same rule as a loan's own status (decision 0001).</summary>
+    private IQueryable<Loan> OverdueLoans()
+    {
+        var overdueBefore = LendingPolicy.OverdueBefore(clock.Today());
+        return db.Loans.Where(l => l.ReturnedAt == null && l.DueDate < overdueBefore);
+    }
+
+    private async Task<MemberDto> ToDto(Member member, CancellationToken cancellationToken) =>
+        MemberDto.From(member, await OverdueLoans().CountAsync(l => l.MemberId == member.Id, cancellationToken));
