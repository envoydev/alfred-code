@@ -0,0 +1,69 @@
+using System.Buffers;
+using System.Buffers.Text;
+using System.Diagnostics.CodeAnalysis;
+using System.Globalization;
+using System.Text;
+
+namespace LendingDesk.Api.Contracts;
+
+/// <summary>
+/// A position in the loan feed's order (due date, then id). On the wire it is <c>yyyy-MM-dd,id</c> in UTF-8,
+/// base64url-encoded without padding. Clients treat it as opaque; binding it from the query string rejects
+/// anything this API would not have issued, so a bad cursor is an ordinary invalid query parameter.
+/// </summary>
+public sealed record LoanCursor(DateOnly DueDate, int Id) : IParsable<LoanCursor>
+{
+    private const string DateFormat = "yyyy-MM-dd";
+
+    // "9999-12-31," plus the longest int is 21 bytes, 28 characters encoded.
+    private const int MaxEncodedLength = 32;
+
+    public string Encode() =>
+        Base64Url.EncodeToString(Encoding.UTF8.GetBytes(string.Create(CultureInfo.InvariantCulture, $"{DueDate:yyyy-MM-dd},{Id}")));
+
+    public static LoanCursor Parse(string s, IFormatProvider? provider) =>
+        TryParse(s, provider, out var cursor) ? cursor : throw new FormatException("Not a loan cursor.");
+
+    public static bool TryParse([NotNullWhen(true)] string? s, IFormatProvider? provider, [MaybeNullWhen(false)] out LoanCursor result)
+    {
+        result = null;
+        if (s is null || s.Length > MaxEncodedLength)
+        {
+            return false;
+        }
+
+        // Padding is not part of the format, but a client that adds the standard padding is still understood.
+        var unpadded = s.TrimEnd('=');
+        var padding = s.Length - unpadded.Length;
+        if (padding != 0 && padding != (4 - (unpadded.Length % 4)) % 4)
+        {
+            return false;
+        }
+
+        Span<byte> bytes = stackalloc byte[Base64Url.GetMaxDecodedLength(MaxEncodedLength)];
+        if (Base64Url.DecodeFromChars(unpadded, bytes, out _, out var written) != OperationStatus.Done)
+        {
+            return false;
+        }
+
+        var text = Encoding.UTF8.GetString(bytes[..written]);
+        var comma = text.IndexOf(',', StringComparison.Ordinal);
+        if (comma < 0
+            || !DateOnly.TryParseExact(text.AsSpan(0, comma), DateFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out var dueDate)
+            || !int.TryParse(text.AsSpan(comma + 1), NumberStyles.None, CultureInfo.InvariantCulture, out var id)
+            || id < 1)
+        {
+            return false;
+        }
+
+        // Only the exact text and encoding this API issues: no leading zeros, stray characters or stray bits.
+        var cursor = new LoanCursor(dueDate, id);
+        if (cursor.Encode() != unpadded)
+        {
+            return false;
+        }
+
+        result = cursor;
+        return true;
+    }
+}
