@@ -0,0 +1,248 @@
+using System.Globalization;
+using System.Net;
+using System.Text;
+using System.Text.Json;
+using LendingDesk.Api.Contracts;
+using LendingDesk.Domain.Loans;
+using LendingDesk.IntegrationTests.Infrastructure;
+using Microsoft.EntityFrameworkCore;
+
+namespace LendingDesk.IntegrationTests;
+
+[Collection(DatabaseGroup.Name)]
+public sealed class LoanFeedApiTests(PostgresFixture postgres) : IAsyncLifetime
+{
+    private LendingApiFactory _api = null!;
+    private HttpClient _staff = null!;
+
+    public async Task InitializeAsync()
+    {
+        _api = await LendingApiFactory.StartAsync(postgres);
+        _staff = _api.ClientAs("staff");
+    }
+
+    public async Task DisposeAsync() => await _api.DisposeAsync();
+
+    /// <summary>The documented cursor format, spelled out independently of the API's own encoder.</summary>
+    private static string Cursor(string text) =>
+        Convert.ToBase64String(Encoding.UTF8.GetBytes(text)).TrimEnd('=').Replace('+', '-').Replace('/', '_');
+
+    private static string Cursor(LoanDto loan) =>
+        Cursor(string.Create(CultureInfo.InvariantCulture, $"{loan.DueDate:yyyy-MM-dd},{loan.Id}"));
+
+    private async Task<(int MemberId, int ItemId)> SeedAsync()
+    {
+        var suffix = Guid.NewGuid().ToString("N")[..8].ToUpperInvariant();
+        var member = await (await _staff.PostJsonAsync("/api/members", new { name = $"Member {suffix}", email = $"m{suffix}@example.com" })).ReadAsync<MemberDto>();
+        var item = await (await _staff.PostJsonAsync("/api/items", new { name = $"Item {suffix}", category = "Tools", sku = $"SKU-{suffix}", totalStock = 50 })).ReadAsync<ItemDto>();
+        return (member.Id, item.Id);
+    }
+
+    /// <summary>Loans due the given number of days from today, written straight to the database.</summary>
+    private Task<List<int>> AddLoansAsync(int memberId, int itemId, params int[] dueInDays) =>
+        _api.WithDbAsync(async db =>
+        {
+            var loans = dueInDays.Select(days => new Loan
+            {
+                ItemId = itemId,
+                MemberId = memberId,
+                StartDate = _api.Clock.Today.AddDays(days - 7),
+                DueDate = _api.Clock.Today.AddDays(days),
+                CreatedAt = _api.Clock.Now,
+            }).ToList();
+            db.Loans.AddRange(loans);
+            await db.SaveChangesAsync();
+            return loans.Select(l => l.Id).ToList();
+        });
+
+    private async Task<LoanFeed> FeedAsync(string query)
+    {
+        var response = await _staff.GetAsync($"/api/loans/feed{query}");
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        return await response.ReadAsync<LoanFeed>();
+    }
+
+    private async Task<List<LoanDto>> ListAsync(string query) =>
+        [.. (await (await _staff.GetAsync($"/api/loans?pageSize=100{query}")).ReadAsync<PagedResult<LoanDto>>()).Items];
+
+    /// <summary>Follows the cursors to the end, returning every page.</summary>
+    private async Task<List<LoanFeed>> WalkAsync(string query)
+    {
+        var pages = new List<LoanFeed> { await FeedAsync($"?{query}") };
+        while (pages[^1].NextCursor is { } next)
+        {
+            pages.Add(await FeedAsync($"?{query}&after={next}"));
+        }
+
+        return pages;
+    }
+
+    [Fact]
+    public async Task Walking_the_feed_returns_every_loan_once_in_the_list_s_order()
+    {
+        var (memberId, itemId) = await SeedAsync();
+        await AddLoansAsync(memberId, itemId, 3, 1, 3, 2, 1, -2);
+
+        var pages = await WalkAsync("limit=2");
+
+        Assert.Equal([2, 2, 2], pages.Select(p => p.Items.Count));
+        Assert.Equal(await ListAsync(string.Empty), pages.SelectMany(p => p.Items));
+        Assert.All(pages[..^1], p => Assert.Equal(Cursor(p.Items[^1]), p.NextCursor));
+        Assert.Null(pages[^1].NextCursor);
+    }
+
+    [Fact]
+    public async Task The_page_is_twenty_loans_unless_a_limit_is_given()
+    {
+        var (memberId, itemId) = await SeedAsync();
+        await AddLoansAsync(memberId, itemId, [.. Enumerable.Range(1, 21)]);
+
+        var first = await FeedAsync(string.Empty);
+        var rest = await FeedAsync($"?after={first.NextCursor}");
+
+        Assert.Equal(20, first.Items.Count);
+        Assert.Equal([21], rest.Items.Select(l => l.DueDate.DayNumber - _api.Clock.Today.DayNumber));
+        Assert.Null(rest.NextCursor);
+        Assert.Equal(21, (await FeedAsync("?limit=100")).Items.Count);
+    }
+
+    [Fact]
+    public async Task An_empty_result_is_an_empty_page_without_a_cursor()
+    {
+        var response = await _api.ClientAs("member").GetAsync("/api/loans/feed?memberId=999999");
+
+        var body = await response.ReadAsync<JsonElement>();
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Equal(0, body.GetProperty("items").GetArrayLength());
+        Assert.Equal(JsonValueKind.Null, body.GetProperty("nextCursor").ValueKind);
+        Assert.False(body.TryGetProperty("totalCount", out _));
+    }
