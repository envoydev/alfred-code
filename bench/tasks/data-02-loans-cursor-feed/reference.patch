+    /// <summary>A bad feed parameter comes back exactly as a bad parameter on the existing list does.</summary>
+    private async Task AssertInvalidParameterAsync(string query, string parameter)
+    {
+        var listResponse = await _staff.GetAsync("/api/loans?pageSize=0");
+        var response = await _staff.GetAsync($"/api/loans/feed?{query}");
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Equal(listResponse.Content.Headers.ContentType, response.Content.Headers.ContentType);
+        var expected = await listResponse.ReadAsync<Problem>();
+        var problem = await response.ReadAsync<Problem>();
+        Assert.Equal((expected.Status, expected.Title, expected.Code), (problem.Status, problem.Title, problem.Code));
+        Assert.Equal([parameter], problem.Errors!.Keys);
+    }
