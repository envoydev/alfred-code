@@ -0,0 +1,45 @@
+﻿using Microsoft.EntityFrameworkCore.Migrations;
+
+#nullable disable
+
+namespace LendingDesk.Data.Migrations
+{
+    /// <inheritdoc />
+    public partial class DropItemIsRetired : Migration
+    {
+        /// <inheritdoc />
+        protected override void Up(MigrationBuilder migrationBuilder)
+        {
+            // Lock first so no instance of the old version can retire an item through IsRetired
+            // between the fill below and the drop, which would lose that retirement.
+            migrationBuilder.Sql("LOCK TABLE \"Items\" IN ACCESS EXCLUSIVE MODE;");
+
+            // The old version kept retiring items through IsRetired after the backfill ran.
+            migrationBuilder.Sql("UPDATE \"Items\" SET \"RetiredAt\" = \"CreatedAt\" WHERE \"IsRetired\" AND \"RetiredAt\" IS NULL;");
+
+            migrationBuilder.AddCheckConstraint(
+                name: "CK_Items_RetiredAt",
+                table: "Items",
+                sql: "\"RetiredAt\" IS NULL OR \"RetiredAt\" >= \"CreatedAt\"");
+
+            migrationBuilder.DropColumn(
+                name: "IsRetired",
+                table: "Items");
+        }
+
+        /// <inheritdoc />
+        protected override void Down(MigrationBuilder migrationBuilder)
+        {
+            migrationBuilder.DropCheckConstraint(
+                name: "CK_Items_RetiredAt",
+                table: "Items");
+
+            migrationBuilder.AddColumn<bool>(
+                name: "IsRetired",
+                table: "Items",
+                type: "boolean",
+                nullable: false,
+                defaultValue: false);
+        }
+    }
+}
