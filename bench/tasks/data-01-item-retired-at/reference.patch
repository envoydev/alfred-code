diff --git a/tests/LendingDesk.IntegrationTests/ItemRetiredAtMigrationTests.cs b/tests/LendingDesk.IntegrationTests/ItemRetiredAtMigrationTests.cs
new file mode 100644
index 0000000..16ea9bc
--- /dev/null
+++ b/tests/LendingDesk.IntegrationTests/ItemRetiredAtMigrationTests.cs
@@ -0,0 +1,187 @@
+using LendingDesk.Data;
+using LendingDesk.IntegrationTests.Infrastructure;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Infrastructure;
+using Microsoft.EntityFrameworkCore.Migrations;
+using Npgsql;
+
+namespace LendingDesk.IntegrationTests;
+
+/// <summary>
+/// <c>IsRetired</c> becomes <c>RetiredAt</c> as expand, backfill, contract. Migrations ship ahead of the code, so
+/// until the contract runs the version in production - which only knows <c>IsRetired</c> - must keep working.
+/// Its statements are written out here as SQL because its model no longer exists in this code.
+/// </summary>
+[Collection(DatabaseGroup.Name)]
+public sealed class ItemRetiredAtMigrationTests(PostgresFixture postgres) : IAsyncLifetime
+{
+    private static readonly DateTimeOffset Created = new(2026, 1, 5, 8, 30, 0, TimeSpan.Zero);
+
+    private string _connectionString = null!;
+
+    public async Task InitializeAsync()
+    {
+        _connectionString = await postgres.CreateDatabaseAsync();
+        await MigrateToAsync("AddNotices");
+    }
+
+    public Task DisposeAsync() => Task.CompletedTask;
+
+    [Fact]
+    public async Task The_three_steps_follow_add_notices_in_order_and_nothing_else_does()
+    {
+        await using var db = NewDb();
+        var names = db.Database.GetMigrations().Select(id => id[(id.IndexOf('_', StringComparison.Ordinal) + 1)..]);
+
+        Assert.Equal(
+            ["AddNotices", "AddItemRetiredAt", "BackfillItemRetiredAt", "DropItemIsRetired"],
+            names.SkipWhile(name => name != "AddNotices"));
+    }
+
+    [Fact]
+    public async Task Expand_adds_a_nullable_timestamp_and_changes_no_data()
+    {
+        var inUse = await InsertTheOldWayAsync("in use", retired: false);
+        var retired = await InsertTheOldWayAsync("retired", retired: true);
+
+        await MigrateToAsync("AddItemRetiredAt");
+
+        Assert.Equal(("timestamp with time zone", "YES", null), await ColumnAsync("RetiredAt"));
+        Assert.Equal(("boolean", "NO", null), await ColumnAsync("IsRetired"));
+        Assert.Equal((false, (DateTimeOffset?)null), await StateAsync(inUse));
+        Assert.Equal((true, (DateTimeOffset?)null), await StateAsync(retired));
+        await AssertTodaysCodeWorksAsync();
+    }
+
+    [Fact]
+    public async Task Backfill_dates_retired_items_by_their_creation_and_leaves_the_rest()
+    {
+        var inUse = await InsertTheOldWayAsync("in use", retired: false);
+        var retired = await InsertTheOldWayAsync("retired", retired: true);
+        var alreadyDated = await InsertTheOldWayAsync("already dated", retired: true);
+        await MigrateToAsync("AddItemRetiredAt");
+        await ExecuteAsync("UPDATE \"Items\" SET \"RetiredAt\" = $1 WHERE \"Id\" = $2", Created.AddDays(3), alreadyDated);
+
+        await MigrateToAsync("BackfillItemRetiredAt");
+
+        Assert.Equal((false, (DateTimeOffset?)null), await StateAsync(inUse));
+        Assert.Equal((true, (DateTimeOffset?)Created), await StateAsync(retired));
+        Assert.Equal((true, (DateTimeOffset?)Created.AddDays(3)), await StateAsync(alreadyDated));
+        await AssertTodaysCodeWorksAsync();
+    }
+
+    [Fact]
+    public async Task Contract_dates_late_retirements_then_constrains_and_drops_is_retired()
+    {
+        var inUse = await InsertTheOldWayAsync("in use", retired: false);
+        var retiredBefore = await InsertTheOldWayAsync("retired before the backfill", retired: true);
+        await MigrateToAsync("BackfillItemRetiredAt");
+        var retiredAfter = await AssertTodaysCodeWorksAsync();
+
+        await MigrateToAsync("DropItemIsRetired");
+
+        Assert.Null(await RetiredAtAsync(inUse));
+        Assert.Equal(Created, await RetiredAtAsync(retiredBefore));
+        Assert.Equal(Created, await RetiredAtAsync(retiredAfter));
+        Assert.Null(await ColumnAsync("IsRetired"));
+
+        var tooEarly = await Assert.ThrowsAsync<PostgresException>(() =>
+            ExecuteAsync("UPDATE \"Items\" SET \"RetiredAt\" = \"CreatedAt\" - interval '1 second' WHERE \"Id\" = $1", inUse));
+        Assert.Equal(PostgresErrorCodes.CheckViolation, tooEarly.SqlState);
+        Assert.Equal("CK_Items_RetiredAt", tooEarly.ConstraintName);
+        await ExecuteAsync("UPDATE \"Items\" SET \"RetiredAt\" = \"CreatedAt\" WHERE \"Id\" = $1", inUse);
+    }
+
+    /// <summary>What the running version does with items: insert without RetiredAt, retire through IsRetired, read it back.</summary>
+    /// <returns>The id of the item it retired.</returns>
+    private async Task<int> AssertTodaysCodeWorksAsync()
+    {
+        var id = await InsertTheOldWayAsync("inserted by today's code", retired: false);
+        await ExecuteAsync("UPDATE \"Items\" SET \"IsRetired\" = TRUE WHERE \"Id\" = $1", id);
+        Assert.Equal((true, (DateTimeOffset?)null), await StateAsync(id));
+        return id;
+    }
+
+    private async Task<int> InsertTheOldWayAsync(string name, bool retired)
+    {
+        await using var connection = await OpenAsync();
+        await using var command = new NpgsqlCommand(
+            """
+            INSERT INTO "Items" ("Category", "CreatedAt", "IsRetired", "Name", "Sku", "TotalStock")
+            VALUES ('Tools', $1, $2, $3, $4, 1)
+            RETURNING "Id"
+            """,
+            connection)
+        {
+            Parameters =
+            {
+                new NpgsqlParameter { Value = Created },
+                new NpgsqlParameter { Value = retired },
+                new NpgsqlParameter { Value = name },
+                new NpgsqlParameter { Value = $"SKU-{Guid.NewGuid().ToString("N")[..8].ToUpperInvariant()}" },
+            },
+        };
+        return (int)(await command.ExecuteScalarAsync())!;
+    }
+
+    private async Task<(bool IsRetired, DateTimeOffset? RetiredAt)> StateAsync(int id)
+    {
+        await using var connection = await OpenAsync();
+        await using var command = new NpgsqlCommand("SELECT \"IsRetired\", \"RetiredAt\" FROM \"Items\" WHERE \"Id\" = $1", connection)
+        {
+            Parameters = { new NpgsqlParameter { Value = id } },
+        };
+        await using var reader = await command.ExecuteReaderAsync();
+        Assert.True(await reader.ReadAsync());
+        return (reader.GetBoolean(0), await reader.GetFieldValueAsync<DateTimeOffset?>(1));
+    }
+
+    private async Task<DateTimeOffset?> RetiredAtAsync(int id)
+    {
+        await using var db = NewDb();
+        return await db.Items.Where(i => i.Id == id).Select(i => i.RetiredAt).SingleAsync();
+    }
+
+    private async Task<(string Type, string Nullable, string? Default)?> ColumnAsync(string column)
+    {
+        await using var connection = await OpenAsync();
+        await using var command = new NpgsqlCommand(
+            "SELECT data_type, is_nullable, column_default FROM information_schema.columns WHERE table_name = 'Items' AND column_name = $1",
+            connection)
+        {
+            Parameters = { new NpgsqlParameter { Value = column } },
+        };
+        await using var reader = await command.ExecuteReaderAsync();
+        return await reader.ReadAsync()
+            ? (reader.GetString(0), reader.GetString(1), await reader.IsDBNullAsync(2) ? null : reader.GetString(2))
+            : null;
+    }
+
+    private async Task ExecuteAsync(string sql, params object[] values)
+    {
+        await using var connection = await OpenAsync();
+        await using var command = new NpgsqlCommand(sql, connection);
+        foreach (var value in values)
+        {
+            command.Parameters.Add(new NpgsqlParameter { Value = value });
+        }
+
+        await command.ExecuteNonQueryAsync();
+    }
+
+    private async Task<NpgsqlConnection> OpenAsync()
+    {
+        var connection = new NpgsqlConnection(_connectionString);
+        await connection.OpenAsync();
+        return connection;
+    }
+
+    private async Task MigrateToAsync(string migration)
+    {
+        await using var db = NewDb();
+        await db.GetService<IMigrator>().MigrateAsync(migration);
+    }
+
+    private LendingDbContext NewDb() =>
+        new(new DbContextOptionsBuilder<LendingDbContext>().UseNpgsql(_connectionString).Options);
+}
