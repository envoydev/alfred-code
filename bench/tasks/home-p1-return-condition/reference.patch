+using LendingDesk.Api.Contracts;
+using LendingDesk.Data;
+using LendingDesk.Domain.Loans;
+using LendingDesk.IntegrationTests.Infrastructure;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Infrastructure;
+using Microsoft.EntityFrameworkCore.Migrations;
+
+namespace LendingDesk.IntegrationTests;
+
+[Collection(DatabaseGroup.Name)]
+public sealed class MigrationTests(PostgresFixture postgres)
+{
+    [Fact]
+    public async Task Loans_recorded_before_return_conditions_upgrade_in_place_with_no_condition_and_no_note()
+    {
+        var connectionString = await postgres.CreateDatabaseAsync();
+        await using (var db = new LendingDbContext(new DbContextOptionsBuilder<LendingDbContext>().UseNpgsql(connectionString).Options))
+        {
+            var migrator = db.GetService<IMigrator>();
+            await migrator.MigrateAsync("20260923001340_AddNotices");
+            await db.Database.ExecuteSqlRawAsync("""
+                INSERT INTO "Members" ("Name", "Email", "CreatedAt") VALUES ('Ada Lovelace', 'ada@example.com', now());
+                INSERT INTO "Items" ("Name", "Category", "Sku", "TotalStock", "IsRetired", "CreatedAt") VALUES ('Cordless drill', 'Tools', 'DRL-1', 2, false, now());
+                INSERT INTO "Loans" ("ItemId", "MemberId", "StartDate", "DueDate", "ReturnedAt", "CreatedAt")
+                SELECT i."Id", m."Id", d."StartDate", d."DueDate", d."ReturnedAt", now()
+                FROM "Items" i, "Members" m,
+                    (VALUES (DATE '2026-03-01', DATE '2026-03-05', TIMESTAMPTZ '2026-03-04 10:00:00+00'),
+                            (DATE '2026-03-09', DATE '2026-03-12', NULL)) AS d("StartDate", "DueDate", "ReturnedAt");
+                """);
+            await migrator.MigrateAsync();
+        }
+
+        await using var api = new LendingApiFactory(connectionString);
+        var loans = await (await api.ClientAs("staff").GetAsync("/api/loans")).ReadAsync<PagedResult<LoanDto>>();
+
+        Assert.Equal([LoanState.Returned, LoanState.Active], loans.Items.Select(l => l.Status));
+        Assert.All(loans.Items, l => Assert.Null(l.ReturnCondition));
+        Assert.All(loans.Items, l => Assert.Null(l.ReturnNote));
