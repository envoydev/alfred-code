+describe('The Check in route', () => {
+  it('opens for staff and admins and sends a member to the loans list', async () => {
+    TestBed.configureTestingModule({
+      providers: [
+        provideRouter([{ path: 'loans', children: loansRoutes }]),
+        ...provideApiTesting(),
+      ],
+    });
+    const httpTesting = TestBed.inject(HttpTestingController);
+    const router = TestBed.inject(Router);
+    const session = TestBed.inject(Session);
+    const harness = await RouterTestingHarness.create();
+
+    session.role.set('member');
+    await harness.navigateByUrl('/loans/check-in');
+    expect(router.url).toBe('/loans');
+    httpTesting.expectOne('/api/loans?page=1&pageSize=10').flush(paged([]));
+
+    session.role.set('staff');
+    await harness.navigateByUrl('/loans/check-in');
+    expect(router.url).toBe('/loans/check-in');
+    expect(TestBed.inject(Title).getTitle()).toBe('Check in');
+    expect(harness.routeNativeElement?.querySelector('h1')?.textContent).toBe('Check in');
+    httpTesting.verify();
+  });
+});
