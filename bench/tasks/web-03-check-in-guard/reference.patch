+<h1>Check in</h1>
+
+<form class="toolbar" [formGroup]="form" (ngSubmit)="find()">
+  <label>
+    Loan number
+    <input type="number" min="1" step="1" formControlName="number" />
+  </label>
+  <button type="submit" [disabled]="!canFind()">Find loan</button>
+</form>
+
+@if (error(); as message) {
+  <p class="alert" role="alert">{{ message }}</p>
+}
+
+@if (loan(); as l) {
+  <table>
+    <thead>
+      <tr>
+        <th scope="col">Loan</th>
+        <th scope="col">Item</th>
+        <th scope="col">Member</th>
+        <th scope="col">Due</th>
+        <th scope="col">Status</th>
+        <th scope="col"><span class="muted">Actions</span></th>
+      </tr>
+    </thead>
+    <tbody>
+      <tr>
+        <td>{{ l.id }}</td>
+        <td>{{ l.itemName }}</td>
+        <td>{{ l.memberName }}</td>
+        <td>{{ l.dueDate }}</td>
+        <td>
+          <span class="badge" [class]="l.status">{{ l.status }}</span>
+        </td>
+        <td>
+          @if (l.status !== 'Returned') {
+            <button type="button" [disabled]="returning()" (click)="checkIn(l)">Check in</button>
+          }
+        </td>
+      </tr>
+    </tbody>
+  </table>
+
+  @if (checkedIn()) {
+    <p role="status">Loan {{ l.id }} checked in.</p>
+  } @else if (l.status === 'Returned') {
+    <p class="muted">This loan has already been returned.</p>
+  }
+}
