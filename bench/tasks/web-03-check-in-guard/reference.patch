+import { Component } from '@angular/core';
+import { TestBed } from '@angular/core/testing';
+import {
+  ActivatedRouteSnapshot,
+  Router,
+  RouterStateSnapshot,
+  UrlTree,
+  provideRouter,
+} from '@angular/router';
+import { RouterTestingHarness } from '@angular/router/testing';
+
+import { Session } from './session';
+import { staffGuard } from './staff-guard';
+
+@Component({ template: '<h1>Loans</h1>' })
+class LoansPage {}
+
+@Component({ template: '<h1>Staff page</h1>' })
+class StaffPage {}
+
+describe('staffGuard', () => {
+  beforeEach(() => {
+    TestBed.configureTestingModule({
+      providers: [
+        provideRouter([
+          { path: 'loans', component: LoansPage },
+          { path: 'staff', canActivate: [staffGuard], component: StaffPage },
+        ]),
+      ],
+    });
+  });
+
+  function runGuard() {
+    return TestBed.runInInjectionContext(() =>
+      staffGuard({} as ActivatedRouteSnapshot, {} as RouterStateSnapshot),
+    );
+  }
+
+  it('lets staff and admins through', () => {
+    const session = TestBed.inject(Session);
+
+    session.role.set('staff');
+    expect(runGuard()).toBe(true);
+    session.role.set('admin');
+    expect(runGuard()).toBe(true);
+  });
+
+  it('sends a member to the loans list without navigating by itself', () => {
+    const router = TestBed.inject(Router);
+    const navigate = vi.spyOn(router, 'navigate');
+    const navigateByUrl = vi.spyOn(router, 'navigateByUrl');
+    TestBed.inject(Session).role.set('member');
+
+    const result = runGuard();
+
+    expect(result).toBeInstanceOf(UrlTree);
+    expect(router.serializeUrl(result as UrlTree)).toBe('/loans');
+    expect(navigate).not.toHaveBeenCalled();
+    expect(navigateByUrl).not.toHaveBeenCalled();
+  });
+
+  it('reads the role picked at the moment of the navigation', async () => {
+    const harness = await RouterTestingHarness.create();
+    const router = TestBed.inject(Router);
+    const session = TestBed.inject(Session);
+
+    session.role.set('member');
+    await harness.navigateByUrl('/staff');
+    expect(router.url).toBe('/loans');
+
+    session.role.set('admin');
+    await harness.navigateByUrl('/staff');
+    expect(router.url).toBe('/staff');
+    expect(harness.routeNativeElement?.textContent).toBe('Staff page');
+  });
+});
