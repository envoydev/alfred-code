@@ -0,0 +1,70 @@
+import { Component, computed, inject, signal } from '@angular/core';
+import { toSignal } from '@angular/core/rxjs-interop';
+import {
+  AbstractControl,
+  NonNullableFormBuilder,
+  ReactiveFormsModule,
+  ValidationErrors,
+  Validators,
+} from '@angular/forms';
+
+import { Loan } from '../../core/models';
+import { problemMessage } from '../../core/problem';
+import { LoansApi } from '../loans-api';
+
+function wholeNumber(control: AbstractControl): ValidationErrors | null {
+  return Number.isInteger(control.value) ? null : { wholeNumber: true };
+}
+
+/** Finds a loan by its number and checks the item back in. */
+@Component({
+  selector: 'app-check-in',
+  imports: [ReactiveFormsModule],
+  templateUrl: './check-in.html',
+})
+export class CheckIn {
+  private readonly api = inject(LoansApi);
+
+  readonly form = inject(NonNullableFormBuilder).group({
+    number: [null as number | null, [Validators.required, Validators.min(1), wholeNumber]],
+  });
+
+  // A signal over the form, so the Find button follows a programmatic change as well as typing.
+  private readonly status = toSignal(this.form.statusChanges, { initialValue: this.form.status });
+  protected readonly canFind = computed(() => this.status() === 'VALID');
+
+  protected readonly loan = signal<Loan | null>(null);
+  protected readonly returning = signal(false);
+  protected readonly checkedIn = signal(false);
+  protected readonly error = signal<string | null>(null);
+
+  protected find(): void {
+    const number = this.form.controls.number.value;
+    if (this.form.invalid || number === null) {
+      return;
+    }
+    this.loan.set(null);
+    this.checkedIn.set(false);
+    this.error.set(null);
+    this.api.get(number).subscribe({
+      next: (loan) => this.loan.set(loan),
+      error: (error: unknown) => this.error.set(problemMessage(error)),
+    });
+  }
+
+  protected checkIn(loan: Loan): void {
+    this.returning.set(true);
+    this.error.set(null);
+    this.api.returnLoan(loan.id).subscribe({
+      next: (returned) => {
+        this.loan.set(returned);
+        this.checkedIn.set(true);
+        this.returning.set(false);
+      },
+      error: (error: unknown) => {
+        this.error.set(problemMessage(error));
+        this.returning.set(false);
+      },
+    });
+  }
+}
