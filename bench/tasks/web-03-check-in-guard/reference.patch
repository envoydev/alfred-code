+    await fixture.whenStable();
+    expect(text(fixture, '[role="alert"]')).toBe('Loan 5 was already returned.');
+    expect(button(fixture, 'Check in')?.disabled).toBe(false);
+    expect(text(fixture, '[role="status"]')).toBeUndefined();
+
+    await findLoan(fixture, '6');
+    httpTesting.expectOne('/api/loans/6').flush(null, { status: 0, statusText: 'Unknown Error' });
+    await fixture.whenStable();
+    expect(text(fixture, '[role="alert"]')).toBe('The server could not be reached.');
+  });
