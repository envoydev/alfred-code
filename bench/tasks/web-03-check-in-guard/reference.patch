+import { loansRoutes } from '../loans.routes';
+import { CheckIn } from './check-in';
+
+describe('CheckIn', () => {
+  let httpTesting: HttpTestingController;
+
+  beforeEach(() => {
+    TestBed.configureTestingModule({ providers: [provideRouter([]), ...provideApiTesting()] });
+    httpTesting = TestBed.inject(HttpTestingController);
+  });
+
+  afterEach(() => httpTesting.verify());
+
+  async function open(): Promise<ComponentFixture<CheckIn>> {
+    const fixture = TestBed.createComponent(CheckIn);
+    await fixture.whenStable();
+    return fixture;
+  }
+
+  function button(fixture: ComponentFixture<CheckIn>, text: string) {
+    return Array.from(
+      (fixture.nativeElement as HTMLElement).querySelectorAll<HTMLButtonElement>('button'),
+    ).find((b) => b.textContent?.trim() === text);
+  }
+
+  function text(fixture: ComponentFixture<CheckIn>, selector: string) {
+    return (fixture.nativeElement as HTMLElement).querySelector(selector)?.textContent?.trim();
+  }
+
+  async function typeNumber(fixture: ComponentFixture<CheckIn>, value: string) {
+    const input = (fixture.nativeElement as HTMLElement).querySelector(
+      'input[type="number"]',
+    ) as HTMLInputElement;
+    input.value = value;
+    input.dispatchEvent(new Event('input'));
+    await fixture.whenStable();
+  }
+
+  async function findLoan(fixture: ComponentFixture<CheckIn>, value: string) {
+    await typeNumber(fixture, value);
+    button(fixture, 'Find loan')?.click();
+    await fixture.whenStable();
+  }
+
+  it('labels the number field and enables Find loan only for a whole number of 1 or more', async () => {
+    const fixture = await open();
+    const label = (fixture.nativeElement as HTMLElement).querySelector('label');
+    expect(label?.textContent?.trim()).toBe('Loan number');
+    expect(label?.querySelector('input[type="number"]')).not.toBeNull();
+    expect(button(fixture, 'Find loan')?.disabled).toBe(true);
+
+    for (const invalid of ['0', '-2', '1.5', '']) {
+      await typeNumber(fixture, invalid);
+      expect(button(fixture, 'Find loan')?.disabled).toBe(true);
+    }
+    await typeNumber(fixture, '1');
+    expect(button(fixture, 'Find loan')?.disabled).toBe(false);
+
+    fixture.componentInstance.form.setValue({ number: 2.5 });
+    await fixture.whenStable();
+    expect(button(fixture, 'Find loan')?.disabled).toBe(true);
+  });
+
+  it('finds an active loan and checks it in', async () => {
+    const fixture = await open();
+
+    await findLoan(fixture, '5');
+    httpTesting
+      .expectOne({ method: 'GET', url: '/api/loans/5' })
+      .flush(
+        aLoan({ id: 5, itemName: 'Ladder', memberName: 'Grace Hopper', dueDate: '2026-09-15' }),
+      );
+    await fixture.whenStable();
+
+    const row = text(fixture, 'tbody tr') ?? '';
+    expect(row).toContain('Ladder');
+    expect(row).toContain('Grace Hopper');
+    expect(row).toContain('2026-09-15');
+    expect(text(fixture, '.badge')).toBe('Active');
+    expect(text(fixture, '[role="status"]')).toBeUndefined();
+
+    button(fixture, 'Check in')?.click();
+    await fixture.whenStable();
+    expect(button(fixture, 'Check in')?.disabled).toBe(true);
+    httpTesting
+      .expectOne({ method: 'POST', url: '/api/loans/5/return' })
+      .flush(aLoan({ id: 5, status: 'Returned', returnedAt: '2026-09-20T08:00:00Z' }));
+    await fixture.whenStable();
+
+    expect(text(fixture, '.badge')).toBe('Returned');
+    expect(button(fixture, 'Check in')).toBeUndefined();
+    expect(text(fixture, '[role="status"]')).toBe('Loan 5 checked in.');
+    expect(fixture.nativeElement.textContent).not.toContain('This loan has already been returned.');
+  });
+
+  it('offers Check in for an overdue loan', async () => {
+    const fixture = await open();
+
+    await findLoan(fixture, '8');
+    httpTesting.expectOne('/api/loans/8').flush(aLoan({ id: 8, status: 'Overdue' }));
+    await fixture.whenStable();
+
+    expect(button(fixture, 'Check in')?.disabled).toBe(false);
+  });
+
+  it('says when the loan found is already returned', async () => {
+    const fixture = await open();
+
+    await findLoan(fixture, '4');
+    httpTesting
+      .expectOne('/api/loans/4')
+      .flush(aLoan({ id: 4, status: 'Returned', returnedAt: '2026-09-10T12:00:00Z' }));
+    await fixture.whenStable();
+
+    expect(button(fixture, 'Check in')).toBeUndefined();
+    expect(fixture.nativeElement.textContent).toContain('This loan has already been returned.');
+    expect(text(fixture, '[role="status"]')).toBeUndefined();
+  });
+
+  it('shows a failed request in the alert', async () => {
+    const fixture = await open();
+
+    await findLoan(fixture, '999');
+    httpTesting
+      .expectOne('/api/loans/999')
+      .flush(
+        { title: 'Not Found', status: 404, detail: 'Loan 999 was not found.' },
+        { status: 404, statusText: 'Not Found' },
+      );
+    await fixture.whenStable();
+    expect(text(fixture, '[role="alert"]')).toBe('Loan 999 was not found.');
+    expect(fixture.nativeElement.querySelector('table')).toBeNull();
+
+    await findLoan(fixture, '5');
+    httpTesting.expectOne('/api/loans/5').flush(aLoan({ id: 5 }));
+    await fixture.whenStable();
+    button(fixture, 'Check in')?.click();
+    httpTesting
+      .expectOne({ method: 'POST', url: '/api/loans/5/return' })
+      .flush(
+        { title: 'Conflict', status: 409, detail: 'Loan 5 was already returned.' },
+        { status: 409, statusText: 'Conflict' },
