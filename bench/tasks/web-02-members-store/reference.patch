@@ -0,0 +1,169 @@
+import { HttpTestingController } from '@angular/common/http/testing';
+import { TestBed } from '@angular/core/testing';
+
+import { aMember, paged, provideApiTesting } from '../testing/fixtures';
+import { MembersStore } from './members-store';
+
+describe('MembersStore', () => {
+  let store: MembersStore;
+  let httpTesting: HttpTestingController;
+
+  const members = [
+    aMember({ id: 1 }),
+    aMember({ id: 2, name: 'Grace Hopper', email: 'grace@example.com' }),
+    aMember({ id: 3, name: 'Alan Turing', email: 'alan@example.com', status: 'Suspended' }),
+  ];
+
+  beforeEach(() => {
+    TestBed.configureTestingModule({ providers: provideApiTesting() });
+    store = TestBed.inject(MembersStore);
+    httpTesting = TestBed.inject(HttpTestingController);
+  });
+
+  afterEach(() => httpTesting.verify());
+
+  function loadPage(): void {
+    store.load({ page: 1, pageSize: 10 });
+    httpTesting.expectOne('/api/members?page=1&pageSize=10').flush(paged(members, 24));
+  }
+
+  function viewMember(id: number): void {
+    store.loadMember(id);
+    httpTesting.expectOne(`/api/members/${id}`).flush(members.find((m) => m.id === id) ?? null);
+  }
+
+  it('starts on page 1 of all members with nothing loaded', () => {
+    expect(store.filter()).toEqual({ page: 1, pageSize: 10 });
+    expect(store.members()).toEqual([]);
+    expect(store.totalCount()).toBe(0);
+    expect(store.pageCount()).toBe(1);
+    expect(store.loading()).toBe(false);
+    expect(store.member()).toBeNull();
+    expect(store.suspending()).toBe(false);
+    expect(store.error()).toBeNull();
+  });
+
+  it('loads a page and tracks the loading flag and filter', () => {
+    store.load({ page: 2, pageSize: 10, status: 'Suspended' });
+
+    expect(store.loading()).toBe(true);
+    expect(store.filter()).toEqual({ page: 2, pageSize: 10, status: 'Suspended' });
+    httpTesting
+      .expectOne('/api/members?page=2&pageSize=10&status=Suspended')
+      .flush(paged(members, 24));
+
+    expect(store.loading()).toBe(false);
+    expect(store.members().map((m) => m.id)).toEqual([1, 2, 3]);
+    expect(store.totalCount()).toBe(24);
+    expect(store.pageCount()).toBe(3);
+  });
+
+  it('reloads the current filter and keeps the rows until the new page arrives', () => {
+    store.load({ page: 2, pageSize: 10, status: 'Active' });
+    httpTesting
+      .expectOne('/api/members?page=2&pageSize=10&status=Active')
+      .flush(paged(members, 24));
+
+    store.load();
+    expect(store.loading()).toBe(true);
+    expect(store.members()).toHaveLength(3);
+    httpTesting
+      .expectOne('/api/members?page=2&pageSize=10&status=Active')
+      .flush(paged([aMember({ id: 9 })], 11));
+
+    expect(store.members().map((m) => m.id)).toEqual([9]);
+    expect(store.pageCount()).toBe(2);
+  });
+
+  it('keeps the rows and total and shows the problem when a page fails to load', () => {
+    loadPage();
+
+    store.load({ ...store.filter(), page: 2 });
+    httpTesting
+      .expectOne('/api/members?page=2&pageSize=10')
+      .flush(null, { status: 500, statusText: 'Server Error' });
+
+    expect(store.loading()).toBe(false);
+    expect(store.error()).toBe('Something went wrong. Please try again.');
+    expect(store.members()).toHaveLength(3);
+    expect(store.totalCount()).toBe(24);
+
+    store.load();
+    expect(store.error()).toBeNull();
+    httpTesting.expectOne('/api/members?page=2&pageSize=10').flush(paged(members, 24));
+  });
+
+  it('loads a member, dropping the one viewed before', () => {
+    viewMember(1);
+    expect(store.member()?.name).toBe('Ada Lovelace');
+
+    store.loadMember(2);
+    expect(store.member()).toBeNull();
+    httpTesting.expectOne('/api/members/2').flush(members[1]);
+
+    expect(store.member()?.name).toBe('Grace Hopper');
+  });
+
+  it('shows the problem when a member cannot be loaded', () => {
+    store.loadMember(99);
+    httpTesting
+      .expectOne('/api/members/99')
+      .flush(
+        { title: 'Not Found', status: 404, detail: 'Member 99 was not found.' },
+        { status: 404, statusText: 'Not Found' },
+      );
+
+    expect(store.error()).toBe('Member 99 was not found.');
+    expect(store.member()).toBeNull();
+  });
+
+  it('suspends a member and replaces it where it is viewed and on the current page', () => {
+    loadPage();
+    viewMember(2);
+
+    store.suspend(2);
+    expect(store.suspending()).toBe(true);
+    httpTesting
+      .expectOne({ method: 'POST', url: '/api/members/2/suspend' })
+      .flush({ ...members[1], status: 'Suspended' });
+
+    expect(store.suspending()).toBe(false);
+    expect(store.member()?.status).toBe('Suspended');
+    expect(store.members().map((m) => m.status)).toEqual(['Active', 'Suspended', 'Suspended']);
+  });
+
+  it('leaves the viewed member alone when another member is suspended', () => {
+    loadPage();
+    viewMember(1);
+
+    store.suspend(2);
+    httpTesting
+      .expectOne({ method: 'POST', url: '/api/members/2/suspend' })
+      .flush({ ...members[1], status: 'Suspended' });
+
+    expect(store.member()).toEqual(members[0]);
+    expect(store.members()[1].status).toBe('Suspended');
+  });
+
+  it('keeps the member and rows and shows the problem when a suspend fails', () => {
+    loadPage();
+    viewMember(1);
+
+    store.suspend(1);
+    httpTesting
+      .expectOne({ method: 'POST', url: '/api/members/1/suspend' })
+      .flush(
+        { title: 'Conflict', status: 409, detail: 'Member 1 has loans still out.' },
+        { status: 409, statusText: 'Conflict' },
+      );
+
+    expect(store.suspending()).toBe(false);
+    expect(store.error()).toBe('Member 1 has loans still out.');
+    expect(store.member()).toEqual(members[0]);
+    expect(store.members()).toEqual(members);
+
+    store.loadMember(1);
+    expect(store.error()).toBeNull();
+    httpTesting.expectOne('/api/members/1').flush(members[0]);
+  });
+});
