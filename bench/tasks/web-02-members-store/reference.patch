+import { HttpTestingController } from '@angular/common/http/testing';
+import { ComponentFixture, TestBed } from '@angular/core/testing';
+import { provideRouter } from '@angular/router';
+
+import { aLoan, aMember, paged, provideApiTesting } from '../../testing/fixtures';
+import { MemberDetail } from './member-detail';
+
+describe('MemberDetail', () => {
+  let httpTesting: HttpTestingController;
+
+  beforeEach(() => {
+    TestBed.configureTestingModule({ providers: [provideRouter([]), ...provideApiTesting()] });
+    httpTesting = TestBed.inject(HttpTestingController);
+  });
+
+  afterEach(() => httpTesting.verify());
+
+  function open(id: string): ComponentFixture<MemberDetail> {
+    const fixture = TestBed.createComponent(MemberDetail);
+    fixture.componentRef.setInput('id', id);
+    fixture.detectChanges();
+    return fixture;
+  }
+
+  function flushLoans(memberId: number): void {
+    httpTesting
+      .expectOne('/api/loans?page=1&pageSize=50&memberId=' + memberId)
+      .flush(paged([aLoan({ memberId })]));
+  }
+
+  function suspendButton(fixture: ComponentFixture<MemberDetail>): HTMLButtonElement | undefined {
+    return Array.from(
+      (fixture.nativeElement as HTMLElement).querySelectorAll<HTMLButtonElement>('.toolbar button'),
+    ).find((button) => button.textContent?.trim() === 'Suspend');
+  }
+
+  it('shows Loading until the member arrives, never the member viewed before', async () => {
+    const before = open('3');
+    httpTesting.expectOne('/api/members/3').flush(aMember({ id: 3, name: 'Grace Hopper' }));
+    flushLoans(3);
+    await before.whenStable();
+    expect((before.nativeElement as HTMLElement).querySelector('h1')?.textContent).toBe(
+      'Grace Hopper',
+    );
+    before.destroy();
+
+    const fixture = open('7');
+    const element = fixture.nativeElement as HTMLElement;
+    expect(element.querySelector('h1')).toBeNull();
+    expect(element.textContent).not.toContain('Grace Hopper');
+    expect(element.querySelector('p.muted')?.textContent?.trim()).toBe('Loading...');
+
+    httpTesting
+      .expectOne('/api/members/7')
+      .flush(aMember({ id: 7, name: 'Ada Lovelace', email: 'ada@example.com' }));
+    flushLoans(7);
+    await fixture.whenStable();
+
+    expect(element.querySelector('h1')?.textContent).toBe('Ada Lovelace');
+    const fields = element.querySelector('.fields')?.textContent ?? '';
+    expect(fields).toContain('ada@example.com');
+    expect(fields).toContain('Active');
+    expect(fields).toContain('2026');
+    expect(element.textContent).not.toContain('Loading...');
+  });
+
+  it('suspends an active member and then drops the button', async () => {
+    const fixture = open('7');
+    httpTesting.expectOne('/api/members/7').flush(aMember({ id: 7 }));
+    flushLoans(7);
+    await fixture.whenStable();
+
+    suspendButton(fixture)?.click();
+    await fixture.whenStable();
+    expect(suspendButton(fixture)?.disabled).toBe(true);
+    httpTesting
+      .expectOne({ method: 'POST', url: '/api/members/7/suspend' })
+      .flush(aMember({ id: 7, status: 'Suspended' }));
+    await fixture.whenStable();
+
+    expect(suspendButton(fixture)).toBeUndefined();
+    expect(
+      (fixture.nativeElement as HTMLElement).querySelector('.fields .badge')?.textContent,
+    ).toBe('Suspended');
+  });
+
+  it('offers no Suspend for a suspended member', async () => {
+    const fixture = open('7');
+    httpTesting.expectOne('/api/members/7').flush(aMember({ id: 7, status: 'Suspended' }));
+    flushLoans(7);
+    await fixture.whenStable();
+
+    expect(suspendButton(fixture)).toBeUndefined();
+  });
+
+  it('shows a failed request in the alert', async () => {
+    const missing = open('99');
+    httpTesting
+      .expectOne('/api/members/99')
+      .flush(
+        { title: 'Not Found', status: 404, detail: 'Member 99 was not found.' },
+        { status: 404, statusText: 'Not Found' },
+      );
+    httpTesting.expectOne('/api/loans?page=1&pageSize=50&memberId=99').flush(paged([]));
+    await missing.whenStable();
+    const element = missing.nativeElement as HTMLElement;
+    expect(element.querySelector('[role="alert"]')?.textContent).toContain(
+      'Member 99 was not found.',
+    );
+    expect(element.querySelector('h1')).toBeNull();
+    missing.destroy();
+
+    const fixture = open('7');
+    httpTesting.expectOne('/api/members/7').flush(aMember({ id: 7 }));
+    flushLoans(7);
+    await fixture.whenStable();
+    suspendButton(fixture)?.click();
+    httpTesting
+      .expectOne({ method: 'POST', url: '/api/members/7/suspend' })
+      .flush(
+        { title: 'Conflict', status: 409, detail: 'Member 7 has loans still out.' },
+        { status: 409, statusText: 'Conflict' },
+      );
+    await fixture.whenStable();
+
+    expect(
+      (fixture.nativeElement as HTMLElement).querySelector('[role="alert"]')?.textContent,
+    ).toContain('Member 7 has loans still out.');
+    expect(suspendButton(fixture)?.disabled).toBe(false);
+  });
+});
