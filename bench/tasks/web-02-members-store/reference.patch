@@ -0,0 +1,78 @@
+import { Injectable, computed, inject, signal } from '@angular/core';
+
+import { pageCount } from '../core/api';
+import { Member } from '../core/models';
+import { problemMessage } from '../core/problem';
+import { MemberQuery, MembersApi } from './members-api';
+
+const DEFAULT_MEMBER_FILTER: MemberQuery = { page: 1, pageSize: 10 };
+
+/** The member list and the member being viewed. Lives with the app, so the list keeps its place. */
+@Injectable({ providedIn: 'root' })
+export class MembersStore {
+  private readonly api = inject(MembersApi);
+
+  private readonly _members = signal<Member[]>([]);
+  private readonly _totalCount = signal(0);
+  private readonly _filter = signal<MemberQuery>(DEFAULT_MEMBER_FILTER);
+  private readonly _loading = signal(false);
+  private readonly _member = signal<Member | null>(null);
+  private readonly _suspending = signal(false);
+  private readonly _error = signal<string | null>(null);
+
+  readonly members = this._members.asReadonly();
+  readonly totalCount = this._totalCount.asReadonly();
+  readonly filter = this._filter.asReadonly();
+  readonly loading = this._loading.asReadonly();
+  readonly member = this._member.asReadonly();
+  readonly suspending = this._suspending.asReadonly();
+  readonly error = this._error.asReadonly();
+
+  readonly pageCount = computed(() => pageCount(this._totalCount(), this._filter().pageSize));
+
+  /** Loads one page of members. The filter replaces the current one. */
+  load(filter: MemberQuery = this._filter()): void {
+    this._filter.set(filter);
+    this._loading.set(true);
+    this._error.set(null);
+    this.api.list(filter).subscribe({
+      next: (result) => {
+        this._members.set(result.items);
+        this._totalCount.set(result.totalCount);
+        this._loading.set(false);
+      },
+      error: (error: unknown) => {
+        this._error.set(problemMessage(error));
+        this._loading.set(false);
+      },
+    });
+  }
+
+  /** Loads one member to view, dropping the one viewed before. */
+  loadMember(id: number): void {
+    this._member.set(null);
+    this._error.set(null);
+    this.api.get(id).subscribe({
+      next: (member) => this._member.set(member),
+      error: (error: unknown) => this._error.set(problemMessage(error)),
+    });
+  }
+
+  suspend(id: number): void {
+    this._suspending.set(true);
+    this._error.set(null);
+    this.api.suspend(id).subscribe({
+      next: (suspended) => {
+        this._member.update((member) => (member?.id === id ? suspended : member));
+        this._members.update((members) =>
+          members.map((member) => (member.id === id ? suspended : member)),
+        );
+        this._suspending.set(false);
+      },
+      error: (error: unknown) => {
+        this._error.set(problemMessage(error));
+        this._suspending.set(false);
+      },
+    });
+  }
+}
